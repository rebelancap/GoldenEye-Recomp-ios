+namespace rex::graphics {
+
+void CountGpuDispatch(DispatchKind kind) {
+  const auto i = size_t(kind);
+  if (i < size_t(DispatchKind::kCount)) {
+    g_dispatches[i].fetch_add(1, std::memory_order_relaxed);
+  }
+}
 
+void GetGpuDispatchStats(uint64_t* out, size_t count) {
+  const size_t n = count < size_t(DispatchKind::kCount) ? count : size_t(DispatchKind::kCount);
+  for (size_t i = 0; i < n; ++i) {
+    out[i] = g_dispatches[i].exchange(0, std::memory_order_relaxed);
+  }
+}
+
+
+}  // namespace rex::graphics
+
