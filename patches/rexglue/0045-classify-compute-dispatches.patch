 std::atomic<uint64_t> g_swaps{0};
+// One per compute-dispatch launch site (M-061's ~47 per frame). A trace can
+// count them but cannot name them; this names them.
+std::atomic<uint64_t>
+    g_dispatches[size_t(rex::graphics::DispatchKind::kCount)];
 }  // namespace
