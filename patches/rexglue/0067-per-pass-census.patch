+uint32_t g_census_pass_count = 0;
+int32_t g_census_current = -1;
+uint32_t g_census_pending_dispatches[kCensusDispatchKinds] = {};
+uint32_t g_census_dropped = 0;
+
+inline bool CensusCapturing() {
+  return g_census_state.load(std::memory_order_relaxed) == kCensusCapturing;
+}
+
+void CensusBeginPass(uint32_t kind, uint32_t width, uint32_t height, uint32_t samples,
+                     uint32_t color_count, const uint32_t* rt_keys, const uint32_t* vk_formats,
+                     uint32_t pitch_tiles) {
+  if (g_census_pass_count >= kCensusMaxPasses) {
+    ++g_census_dropped;
+    g_census_current = -1;
+    return;
+  }
+  CensusPass& p = g_census_passes[g_census_pass_count];
+  std::memset(&p, 0, sizeof(p));
+  p.kind = kind;
+  p.width = width;
+  p.height = height;
+  p.samples = samples;
+  p.color_count = color_count;
+  p.pitch_tiles = pitch_tiles;
+  if (rt_keys) {
+    std::memcpy(p.rt_keys, rt_keys, sizeof(p.rt_keys));
+  }
+  if (vk_formats) {
+    std::memcpy(p.vk_formats, vk_formats, sizeof(p.vk_formats));
+  }
+  std::memcpy(p.pre_dispatches, g_census_pending_dispatches, sizeof(p.pre_dispatches));
+  std::memset(g_census_pending_dispatches, 0, sizeof(g_census_pending_dispatches));
+  g_census_current = int32_t(g_census_pass_count);
+  ++g_census_pass_count;
+}
+
+void CensusCountDraw(uint32_t vertices, bool blend, uint32_t scissor_w, uint32_t scissor_h,
+                     const VkRect2D& sc, const VkViewport& vp, uint32_t window_offset_reg) {
+  if (g_census_current < 0) {
+    return;
+  }
+  CensusPass& p = g_census_passes[g_census_current];
+  if (p.draws == 0) {
+    p.sc_x0 = sc.offset.x; p.sc_y0 = sc.offset.y;
+    p.sc_x1 = sc.offset.x + int32_t(sc.extent.width); p.sc_y1 = sc.offset.y + int32_t(sc.extent.height);
+    p.vp_x0 = int32_t(vp.x); p.vp_y0 = int32_t(vp.y);
+    p.vp_x1 = int32_t(vp.x + vp.width); p.vp_y1 = int32_t(vp.y + vp.height);
+    p.window_offset_reg = window_offset_reg;
+  } else {
+    p.sc_x0 = std::min(p.sc_x0, sc.offset.x); p.sc_y0 = std::min(p.sc_y0, sc.offset.y);
+    p.sc_x1 = std::max(p.sc_x1, sc.offset.x + int32_t(sc.extent.width));
+    p.sc_y1 = std::max(p.sc_y1, sc.offset.y + int32_t(sc.extent.height));
+    p.vp_x0 = std::min(p.vp_x0, int32_t(vp.x)); p.vp_y0 = std::min(p.vp_y0, int32_t(vp.y));
+    p.vp_x1 = std::max(p.vp_x1, int32_t(vp.x + vp.width));
+    p.vp_y1 = std::max(p.vp_y1, int32_t(vp.y + vp.height));
+  }
+  ++p.draws;
+  p.vertices += vertices;
+  if (blend) {
+    ++p.blend_draws;
+  }
+  p.max_scissor_w = std::max(p.max_scissor_w, scissor_w);
+  p.max_scissor_h = std::max(p.max_scissor_h, scissor_h);
+}
+
+// Called from EndSubmission(is_swap=true), i.e. at the guest frame boundary.
+void CensusSwap() {
+  const uint32_t state = g_census_state.load(std::memory_order_relaxed);
+  if (state == kCensusArmed) {
+    g_census_pass_count = 0;
+    g_census_current = -1;
+    g_census_dropped = 0;
+    std::memset(g_census_pending_dispatches, 0, sizeof(g_census_pending_dispatches));
+    g_census_state.store(kCensusCapturing, std::memory_order_release);
+  } else if (state == kCensusCapturing) {
+    // Keep-alive swaps (M-083: VdSwap fires with no frame behind it) arrive
+    // back to back; closing on one of those returned an empty table on .62.
+    // A frame is a span that contained at least one pass.
+    if (g_census_pass_count == 0) {
+      return;
+    }
+    g_census_current = -1;
+    g_census_state.store(kCensusDone, std::memory_order_release);
+  }
+}
