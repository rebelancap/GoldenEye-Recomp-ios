+constexpr uint32_t kCensusMaxColorRts = rex::graphics::xenos::kMaxColorRenderTargets;
+enum : uint32_t {
+  kCensusIdle = 0,
+  kCensusArmed = 1,    // start at the next swap
+  kCensusCapturing = 2,
+  kCensusDone = 3,
+};
+struct CensusPass {
+  uint32_t kind;  // 0 = guest render target, 1 = EDRAM transfer, 2 = swap gamma
+  uint32_t width, height;
+  uint32_t samples;
+  uint32_t color_count;
+  uint32_t rt_keys[1 + kCensusMaxColorRts];     // depth first; 0 = unused
+  uint32_t vk_formats[1 + kCensusMaxColorRts];  // host VkFormat
+  uint32_t pitch_tiles;
+  uint32_t draws;
+  uint32_t vertices;
+  uint32_t blend_draws;
+  uint32_t max_scissor_w, max_scissor_h;
+  // Union of every draw's scissor and viewport, in host pixels: tells whether a
+  // predicated-tiling pass really is confined to its tile (M-100).
+  int32_t sc_x0, sc_y0, sc_x1, sc_y1;
+  int32_t vp_x0, vp_y0, vp_x1, vp_y1;
+  uint32_t window_offset_reg;
+  uint32_t pre_dispatches[kCensusDispatchKinds];
