+// ---- GEPASS per-pass census (patch 0067) -----------------------------------
+// M-099 attributed the Dam frame to fragment work inside ~25 guest render
+// passes -- one of them 8.3 ms, 44% of the frame -- but Metal System Trace can
+// only number the encoders, not name the guest render target each one draws
+// into. This names them: `passes` on the console arms a ONE-frame capture and
+// the next inter-swap span is recorded pass by pass, with the guest
+// RenderTargetKey identity of every attachment, the draw/vertex/blend counts,
+// and the compute dispatches that ran between passes.
+//
+// Zero-cost when idle: every hot-path hook is one relaxed load of
+// g_census_state. Only the GPU worker thread writes the table, and only while
+// the state is kCapturing, so no locking is needed -- the console thread reads
+// it after the state has been released as kDone.
+constexpr uint32_t kCensusDispatchKinds = uint32_t(rex::graphics::DispatchKind::kCount);
+constexpr uint32_t kCensusMaxPasses = 128;
+// This file's anonymous namespace is at global scope, so `xenos::` does not
