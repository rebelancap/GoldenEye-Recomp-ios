+// ---- GEPASS per-pass census readout (patch 0067) ----------------------------
+// The table is rendered here rather than in the console bridge because only
+// this translation unit knows what a RenderTargetKey means, and the bridge
+// lives in rexruntime, which does not link rexgraphics (see
+// rex/ui/vulkan/presenter_timings.h) -- it reaches this by dlsym, as text.
+namespace {
+
+void CensusAppendAttachment(std::string& s, const char* label, uint32_t key_bits,
+                            uint32_t vk_format) {
+  if (!key_bits) {
+    return;
+  }
+  rex::graphics::vulkan::VulkanRenderTargetCache::PassCensusKey key;
+  key.key = key_bits;
+  char tmp[224];
+  std::snprintf(tmp, sizeof(tmp), " %s=[0x%08x b=%ut p=%ut s=%ux %s %s vk=%u]", label, key_bits,
+                uint32_t(key.base_tiles), key.GetPitchTiles(),
+                uint32_t(1) << uint32_t(key.msaa_samples), key.GetFormatName(),
+                key.Is64bpp() ? "64bpp" : "32bpp", vk_format);
+  s += tmp;
+}
+
+void CensusAppendDispatches(std::string& s, const char* label, const uint32_t* counts) {
+  bool any = false;
+  for (uint32_t k = 0; k < kCensusDispatchKinds; ++k) {
+    if (!counts[k]) {
+      continue;
+    }
+    s += any ? "," : label;
+    any = true;
+    s += rex::graphics::DispatchKindName(rex::graphics::DispatchKind(k));
+    s += ":";
+    s += std::to_string(counts[k]);
+  }
+}
+
+std::string CensusText() {
+  std::string s;
+  char buf[640];
+  uint32_t total_draws = 0, total_verts = 0;
+  for (uint32_t i = 0; i < g_census_pass_count; ++i) {
+    total_draws += g_census_passes[i].draws;
+    total_verts += g_census_passes[i].vertices;
+  }
+  std::snprintf(buf, sizeof(buf), "GEPASS frame passes=%u draws=%u vtx=%u dropped=%u\n",
+                g_census_pass_count, total_draws, total_verts, g_census_dropped);
+  s += buf;
+  for (uint32_t i = 0; i < g_census_pass_count; ++i) {
+    const CensusPass& p = g_census_passes[i];
+    const char* kind = p.kind == 0 ? "guest" : (p.kind == 1 ? "xfer " : "swap ");
+    std::snprintf(buf, sizeof(buf), "GEPASS[%02u] %s %ux%u s%u col=%u pitch=%ut", i, kind, p.width,
+                  p.height, p.samples, p.color_count, p.pitch_tiles);
+    s += buf;
+    CensusAppendAttachment(s, "d", p.rt_keys[0], p.vk_formats[0]);
+    for (uint32_t c = 0; c < kCensusMaxColorRts; ++c) {
+      const char* labels[4] = {"c0", "c1", "c2", "c3"};
+      CensusAppendAttachment(s, labels[c], p.rt_keys[1 + c], p.vk_formats[1 + c]);
+    }
+    std::snprintf(buf, sizeof(buf), " draws=%u vtx=%u blend=%u scis=%ux%u", p.draws, p.vertices,
+                  p.blend_draws, p.max_scissor_w, p.max_scissor_h);
+    s += buf;
+    if (p.draws) {
+      std::snprintf(buf, sizeof(buf), " scU=[%d,%d %dx%d] vpU=[%d,%d %dx%d] wofs=%#x", p.sc_x0,
+                    p.sc_y0, p.sc_x1 - p.sc_x0, p.sc_y1 - p.sc_y0, p.vp_x0, p.vp_y0,
+                    p.vp_x1 - p.vp_x0, p.vp_y1 - p.vp_y0, p.window_offset_reg);
+      s += buf;
+    }
+    CensusAppendDispatches(s, " pre=", p.pre_dispatches);
+    s += "\n";
+  }
+  bool trailing = false;
+  for (uint32_t k = 0; k < kCensusDispatchKinds; ++k) {
+    trailing |= g_census_pending_dispatches[k] != 0;
+  }
+  if (trailing) {
+    s += "GEPASS[--] post ";
+    CensusAppendDispatches(s, "", g_census_pending_dispatches);
+    s += "\n";
+  }
+  return s;
+}
+
+}  // namespace
+
+// Arm a one-frame capture: the span between the next two swaps is recorded.
+extern "C" void RexArmPassCensus() {
+  g_census_state.store(kCensusArmed, std::memory_order_release);
+}
+
+// -1 while the armed frame has not completed. `force` gives up waiting and
+// returns whatever was recorded (the console's ~2 s timeout). Returns the
+// number of bytes written, excluding the NUL.
+extern "C" int RexFetchPassCensus(char* out, uint32_t cap, uint32_t force) {
+  if (!out || cap == 0) {
+    return -1;
+  }
+  const uint32_t state = g_census_state.load(std::memory_order_acquire);
+  if (state != kCensusDone) {
+    if (!force || state == kCensusIdle) {
+      return -1;
+    }
+    // Stop the writer before reading its table.
+    g_census_state.store(kCensusIdle, std::memory_order_release);
+  }
+  const std::string text = CensusText();
+  g_census_state.store(kCensusIdle, std::memory_order_release);
+  const size_t n = std::min<size_t>(text.size(), size_t(cap) - 1);
+  std::memcpy(out, text.data(), n);
+  out[n] = '\0';
+  // Also to the app log, so a capture survives the console session.
+  REXGPU_INFO("{}", text);
+  return int(n);
+}
