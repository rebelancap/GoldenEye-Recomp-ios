+namespace {
+// Render-pass and submission accounting. On a tile-based GPU every render pass
+// costs a full tile load and store of its attachment, so pass COUNT is a
+// first-order cost and not a detail -- M-054 needed a 432 MB Instruments trace
+// to establish it was around 18 per frame. Having it in `stat` makes the next
+// round of that work cost nothing.
+std::atomic<uint64_t> g_render_passes{0};
+std::atomic<uint64_t> g_submissions{0};
+std::atomic<uint64_t> g_swaps{0};
+}  // namespace
+
 namespace rex::graphics::vulkan {
+
+void GetGpuPassStats(uint64_t* passes, uint64_t* submissions, uint64_t* swaps) {
+  // exchange: reported over the interval since the last read, so it divides
+  // cleanly into a per-frame number.
+  if (passes) *passes = g_render_passes.exchange(0, std::memory_order_relaxed);
+  if (submissions) *submissions = g_submissions.exchange(0, std::memory_order_relaxed);
+  if (swaps) *swaps = g_swaps.exchange(0, std::memory_order_relaxed);
+}
