+// One increment per NEW guest frame handed to the presenter -- the only
+// counter that means "game frames per second" (M-083: the CP swap counter is
+// vblank-keep-alive-poisoned; host panel presents double-count paints).
+static std::atomic<uint64_t> g_guest_frames_refreshed{0};
+extern "C" uint64_t RexGetGuestFrameCount() {
+  return g_guest_frames_refreshed.load(std::memory_order_relaxed);
+}
