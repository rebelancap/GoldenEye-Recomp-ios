+// Prefer the foreground-active scene; fall back to any window scene, because a
+// scene that is merely foreground-inactive still has correct geometry and is
+// what exists for the instant between connection and activation.
+UIWindowScene* RexActiveWindowScene() {
+  UIWindowScene* fallback = nil;
+  for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+    if (![scene isKindOfClass:UIWindowScene.class]) {
+      continue;
+    }
+    UIWindowScene* window_scene = (UIWindowScene*)scene;
+    if (window_scene.activationState == UISceneActivationStateForegroundActive) {
+      return window_scene;
+    }
+    if (!fallback) {
+      fallback = window_scene;
+    }
+  }
+  return fallback;
+}
+#endif
+
+CGRect RexScreenBounds() {
+#if TARGET_OS_VISION
+  UIWindowScene* scene = RexActiveWindowScene();
+  CGRect bounds = scene ? scene.coordinateSpace.bounds : CGRectZero;
+  // Scene bounds can still be empty in the window between scene connection and
+  // the first layout pass. 1280x720 is a placeholder that viewDidLayoutSubviews
+  // corrects on the very next turn; it exists only so nothing divides by zero.
+  if (CGRectIsEmpty(bounds)) {
+    bounds = CGRectMake(0, 0, 1280, 720);
+  }
+  return bounds;
+#else
+  return UIScreen.mainScreen.bounds;
+#endif
+}
+
+CGFloat RexScreenScale() {
+#if TARGET_OS_VISION
+  UIWindowScene* scene = RexActiveWindowScene();
+  const CGFloat scale = scene ? scene.traitCollection.displayScale : 0;
+  return scale > 0 ? scale : 2.0;
+#else
+  const CGFloat scale = UIScreen.mainScreen.nativeScale;
+  return scale > 0 ? scale : 1.0;
+#endif
+}
+
+float RexMaxFramesPerSecond() {
+#if TARGET_OS_VISION
+  // There is no API for this on visionOS: the compositor owns presentation and
+  // the app does not drive a panel. 90 is the Vision Pro compositor's target
+  // and the rate the display link actually ticks at; the pacer measures the
+  // real period every tick anyway, so this only seeds the requested range.
+  return 90.0f;
+#else
+  return float(UIScreen.mainScreen.maximumFramesPerSecond);
+#endif
+}
+
