 // upstream wall-clock behaviour and the automatic fallback wherever no
 // display link exists. Hot-reload on purpose: the judder A/B flips this live
 // in one device session.
-REXCVAR_DEFINE_STRING(pace, "displaylink", "GPU",
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+// visionOS default is "timer", not "displaylink" (D-024). The Vision Pro
+// compositor runs at 90 Hz and the guest's video mode is 60: 90 has no whole
+// divisor that lands on 60, so the display-linked path can only offer 90 (the
+// guest runs 1.5x fast) or 45 (the guest runs at 0.75x speed). Both are wrong
+// in a way the player feels immediately. The timer path keeps the guest's
+// clock at its own 60 Hz and lets the compositor resample; the cost is a
+// 2:1:2:1 present cadence against the panel rather than an even one. Phase 6
+// replaces this entirely -- CompositorServices hands us the cadence.
+#if TARGET_OS_VISION
+#define REX_DEFAULT_PACE "timer"
+#else
+#define REX_DEFAULT_PACE "displaylink"
+#endif
+REXCVAR_DEFINE_STRING(pace, REX_DEFAULT_PACE, "GPU",
                       "Guest vblank clock source: displaylink (divided from the panel's real "
                       "refresh; falls back to timer if none) or timer (wall clock)")
     .allowed({"displaylink", "timer"})
