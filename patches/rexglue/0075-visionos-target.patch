 namespace {
 rex::ui::UIKitWindowedAppContext* g_app_context = nullptr;
 std::unique_ptr<rex::ui::WindowedApp>* g_app = nullptr;
+
+// Everything didFinishLaunching used to do inline. Factored out because on
+// visionOS it cannot run there (see RexBootWhenSceneReady below).
+void RexBootApp() {
+  g_app_context = new rex::ui::UIKitWindowedAppContext();
+  g_app = new std::unique_ptr<rex::ui::WindowedApp>(
+      rex::ui::GetWindowedAppCreator()(*g_app_context));
+
+  if (!(*g_app)->OnInitialize()) {
+    REXLOG_ERROR("iOS: app OnInitialize failed");
+    rex::ui::ScheduleSettingsSelftest();
+    return;  // stay alive so the log can be retrieved
+  }
+  REXLOG_INFO("iOS: app initialised");
+  rex::ui::ScheduleSettingsSelftest();
+}
+
+#if TARGET_OS_VISION
+// visionOS is scene-based, and UIKit connects the scene AFTER
+// didFinishLaunching returns. Creating the window before then produces a
+// UIWindow with no windowScene, which is never displayed -- an app that
+// launches into an empty void with nothing in the log to explain it.
+//
+// So on visionOS boot is deferred: hop the main queue until a UIWindowScene
+// exists, then run exactly the same boot. In practice this takes one or two
+// turns.
+void RexBootWhenSceneReady(int attempt) {
+  for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+    if ([scene isKindOfClass:UIWindowScene.class]) {
+      RexBootApp();
+      // Logged AFTER the boot, not before it: the file logger is not opened
+      // until config load inside RexBootApp, so anything written here first
+      // goes only to the early sink and never reaches Documents/logs -- which
+      // is exactly how this line went missing on its first run.
+      REXLOG_INFO("visionOS: window scene connected after {} turn(s); booted", attempt);
+      return;
+    }
+  }
+  // ~5 s at 16 ms. If no scene ever arrives the Info.plist scene manifest is
+  // wrong, and booting anyway would only hide that behind a blank window.
+  if (attempt >= 300) {
+    REXLOG_ERROR("visionOS: no UIWindowScene connected after {} turns -- "
+                 "check UIApplicationSceneManifest in Info.plist", attempt);
+    return;
+  }
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, int64_t(16 * NSEC_PER_MSEC)),
+                 dispatch_get_main_queue(), ^{ RexBootWhenSceneReady(attempt + 1); });
+}
+#endif
+
 }  // namespace
 
 @interface RexAppDelegate : UIResponder <UIApplicationDelegate>
