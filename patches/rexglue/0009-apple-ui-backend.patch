--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,6 +7,13 @@
     LANGUAGES C CXX
     DESCRIPTION "Xbox 360 Recompilation SDK"
 )
+
+# The Apple window/surface/app-context backends are Objective-C++.
+if(APPLE)
+    enable_language(OBJCXX)
+    set(CMAKE_OBJCXX_STANDARD 23)
+    set(CMAKE_OBJCXX_STANDARD_REQUIRED ON)
+endif()
 # Floor only: bump MAJOR.MINOR for API changes. Patch is derived from git tags
 # in cmake/rex_version.cmake. See docs/RELEASING.md.
 
@@ -173,6 +180,9 @@
     # iOS/visionOS also take the MAC path there -- intentional for now; anything
     # that must distinguish them uses TARGET_OS_IPHONE / TARGET_OS_VISION.
     add_compile_definitions(REX_PLATFORM_APPLE=1)
+    # MoltenVK's WSI. Must be visible to every target that includes the Vulkan
+    # headers or rex/ui/vulkan/instance.h -- not just rexui.
+    add_compile_definitions(VK_USE_PLATFORM_METAL_EXT=1)
 else()
     message(FATAL_ERROR "Unsupported platform. ReXGlue supports Windows, Linux and Apple platforms.")
 endif()
