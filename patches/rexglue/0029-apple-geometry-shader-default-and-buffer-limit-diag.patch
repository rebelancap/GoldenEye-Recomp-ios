-REXCVAR_DEFINE_BOOL(vulkan_require_geometry_shader, true, "UI/Vulkan",
+// No Metal GPU implements geometry shaders, so MoltenVK never reports
+// geometryShader on any Apple platform. Leaving the requirement on would reject
+// every physical device before the backend is even built -- the Vulkan path
+// would be unusable on macOS, iOS and visionOS alike. The fallback primitive
+// emulation this cvar guards is exactly what those platforms need, so default
+// it off there and leave desktop drivers, which do have the feature, unchanged.
+#if REX_PLATFORM_MAC
+inline constexpr bool kRequireGeometryShaderDefault = false;
+#else
+inline constexpr bool kRequireGeometryShaderDefault = true;
+#endif
+REXCVAR_DEFINE_BOOL(vulkan_require_geometry_shader, kRequireGeometryShaderDefault, "UI/Vulkan",
                     "Require geometryShader support for Vulkan GPU emulation (disable to allow "
-                    "fallback primitive emulation paths)")
+                    "fallback primitive emulation paths). Defaults off on Apple platforms, where "
+                    "Metal has no geometry shader stage.")
     .lifecycle(rex::cvar::Lifecycle::kInitOnly);
