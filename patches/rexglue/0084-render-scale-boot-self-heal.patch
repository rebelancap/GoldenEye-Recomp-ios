 namespace {
+// Boot self-heal for the restart-required render scale (patch 0084, M-108).
+//
+// resolution_scale is kRequiresRestart: the player picks 1440p or 2160p, the
+// app is relaunched, and GPU init commits a 512 MB * scale^2 scaled-resolve
+// buffer. If that allocation is more than the process may have, jetsam kills
+// the app ~150 ms into init -- with no crash report, no UI, and no way back to
+// the settings page to undo the choice. The 0083 guard makes that far less
+// likely; this makes it non-fatal when the guard is still wrong, because the
+// only number that is never wrong is whether the last boot at this scale
+// actually reached steady state.
+//
+// The scheme is a marker file: written just before the scaled buffer is
+// committed, removed once the app has presented kScaleBootSurvivalSwaps
+// frames (or shut down cleanly). Finding it at boot means the previous boot at
+// that scale died before it ever painted, so the scale is reset to the
+// platform default and persisted.
+constexpr uint64_t kScaleBootSurvivalSwaps = 120;
+
+std::filesystem::path ScaleBootWritableDir() {
+  // Documents/ on iOS and visionOS (the sandbox container; the app bundle is
+  // read-only), the executable's own folder on desktop -- the same choice
+  // ReXApp::SetupEnvironment makes for the config file (patch 0027).
+  auto documents = rex::filesystem::GetDocumentsFolder();
+  if (!documents.empty()) {
+    return documents;
+  }
+  return rex::filesystem::GetExecutableFolder();
+}
+
+std::filesystem::path ScaleBootMarkerPath() {
+  return ScaleBootWritableDir() / ".scale-boot-pending";
+}
+
+std::filesystem::path ScaleBootConfigPath() {
+  // "ge.toml", hardcoded for the same reason ui::PersistSettingsNow hardcodes
+  // it: the app object that owns the real config path lives in the game binary
+  // above this library and is not reachable from here.
+  return ScaleBootWritableDir() / "ge.toml";
+}
+
+std::atomic<bool> g_scale_boot_marker_armed{false};
+
+// One-shot: the armed flag makes the per-swap call a single relaxed load once
+// the marker is gone.
+void ScaleBootMarkerClear(const char* why) {
+  if (!g_scale_boot_marker_armed.exchange(false, std::memory_order_acq_rel)) {
+    return;
+  }
+  std::error_code ec;
+  std::filesystem::remove(ScaleBootMarkerPath(), ec);
+  if (ec) {
+    REXGPU_WARN("render scale boot marker could not be removed ({}): {}", why, ec.message());
+  } else {
+    REXGPU_INFO("render scale boot marker cleared ({})", why);
+  }
+}
