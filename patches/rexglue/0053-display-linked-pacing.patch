+// ---------------------------------------------------------------------------
+// Display link -> DisplayPacer feed (docs/pacing.md)
+//
+// The pacer turns the emulated guest vblank into a divided-down copy of the
+// panel's refresh. The link runs on its OWN thread with its own run loop: the
+// main thread also carries every paint and all of UIKit, and a pacing clock
+// that jitters whenever the UI is busy would re-create exactly the phase noise
+// this exists to remove.
+// ---------------------------------------------------------------------------
+
+@interface RexPacerLink : NSObject
+- (void)start;
+- (void)stop;
+@end
+
+@implementation RexPacerLink {
+  CADisplayLink* _link;
+  NSThread* _thread;
+  BOOL _running;
+}
+
+- (void)start {
+  if (_running) return;
+  _running = YES;
+  _thread = [[NSThread alloc] initWithTarget:self selector:@selector(threadMain) object:nil];
+  _thread.name = @"DisplayPacer";
+  // Above default priority: this thread is a clock. It does almost no work
+  // (an atomic increment and a condvar notify per refresh), but it must run
+  // promptly when the panel ticks.
+  _thread.qualityOfService = NSQualityOfServiceUserInteractive;
+  [_thread start];
+}
+
+- (void)threadMain {
+  @autoreleasepool {
+    _link = [CADisplayLink displayLinkWithTarget:self selector:@selector(tick:)];
+    // Ask for the panel's fastest rate; pacing divides it down deliberately.
+    // Without this, UIKit idles the link at 60 even on a 120 Hz panel (and
+    // Info.plist carries CADisableMinimumFrameDurationOnPhone for the same
+    // reason on the present side).
+    if (@available(iOS 15.0, tvOS 15.0, *)) {
+      const float max_fps = float(UIScreen.mainScreen.maximumFramesPerSecond);
+      _link.preferredFrameRateRange = CAFrameRateRangeMake(max_fps, max_fps, max_fps);
+    }
+    [_link addToRunLoop:NSRunLoop.currentRunLoop forMode:NSRunLoopCommonModes];
+    rex::ui::DisplayPacer::Instance().SetLinkActive(true);
+    while (_running &&
+           [NSRunLoop.currentRunLoop runMode:NSDefaultRunLoopMode
+                                  beforeDate:[NSDate dateWithTimeIntervalSinceNow:0.25]]) {
+    }
+    rex::ui::DisplayPacer::Instance().SetLinkActive(false);
+    [_link invalidate];
+    _link = nil;
+  }
+}
 
+- (void)tick:(CADisplayLink*)link {
+  // targetTimestamp - timestamp is the period actually in effect this tick.
+  const double period_s = link.targetTimestamp - link.timestamp;
+  rex::ui::DisplayPacer::Instance().OnDisplayLinkTick(
+      period_s > 0 ? uint64_t(period_s * 1e9) : 0);
+}
+
+- (void)stop {
+  if (!_running) return;
+  _running = NO;
+  // The run loop wakes within 0.25 s and exits; SetLinkActive(false) there
+  // releases any pacer waiters.
+}
+
+@end
+
