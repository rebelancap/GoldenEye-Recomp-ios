 bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
-#if !REX_PLATFORM_LINUX
+#if defined(__APPLE__)
+  // Darwin has no /proc/self/maps; ask the Mach VM directly.
+  //
+  // This is not cosmetic. MMIOHandler::ExceptionCallback uses QueryProtect to
+  // decide whether another thread has already cleared the write-watch it just
+  // faulted on. Returning "false, kNoAccess" unconditionally (the old non-Linux
+  // path) makes that check always say "still protected", so every racing fault
+  // re-enters the access-violation callback instead of aborting early.
   access_out = PageAccess::kNoAccess;
   length = 0;
+
+  vm_address_t region_address = vm_address_t(base_address);
+  vm_size_t region_size = 0;
+  vm_region_basic_info_data_64_t info{};
+  mach_msg_type_number_t info_count = VM_REGION_BASIC_INFO_COUNT_64;
+  mach_port_t object_name = MACH_PORT_NULL;
+  const kern_return_t kr =
+      vm_region_64(mach_task_self(), &region_address, &region_size, VM_REGION_BASIC_INFO_64,
+                   reinterpret_cast<vm_region_info_t>(&info), &info_count, &object_name);
+  if (object_name != MACH_PORT_NULL) {
+    mach_port_deallocate(mach_task_self(), object_name);
+  }
+  if (kr != KERN_SUCCESS) {
+    return false;
+  }
+  // vm_region_64 returns the first region at or AFTER the address; if it starts
+  // past us, base_address is unmapped.
+  const uintptr_t addr = reinterpret_cast<uintptr_t>(base_address);
+  if (uintptr_t(region_address) > addr) {
+    return false;
+  }
+  length = size_t(uintptr_t(region_address) + size_t(region_size) - addr);
+
+  const bool r = (info.protection & VM_PROT_READ) != 0;
+  const bool w = (info.protection & VM_PROT_WRITE) != 0;
+  const bool x = (info.protection & VM_PROT_EXECUTE) != 0;
+  if (!r && !w && !x) {
+    access_out = PageAccess::kNoAccess;
+  } else if (x) {
+    access_out = w ? PageAccess::kExecuteReadWrite : PageAccess::kExecuteReadOnly;
+  } else {
+    access_out = w ? PageAccess::kReadWrite : PageAccess::kReadOnly;
+  }
+  return true;
+#elif !REX_PLATFORM_LINUX
+  access_out = PageAccess::kNoAccess;
+  length = 0;
   return false;
 #else
   access_out = PageAccess::kNoAccess;
