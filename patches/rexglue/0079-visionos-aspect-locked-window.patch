 - (void)viewDidLayoutSubviews {
   [super viewDidLayoutSubviews];
+#if TARGET_OS_VISION
+  // The aspect lock is a REQUEST; the system can refuse or round it. Log what
+  // the scene actually became, once per distinct size, so "no bars" is a
+  // number in the log and not a hope. 16:9 is 1.7778; the presenter's letterbox
+  // is what fills the difference when this drifts.
+  {
+    static CGSize last = CGSizeZero;
+    const CGSize now = self.view.bounds.size;
+    if (!CGSizeEqualToSize(now, last)) {
+      last = now;
+      const double aspect = now.height > 0 ? double(now.width) / double(now.height) : 0.0;
+      REXLOG_INFO("visionOS: scene geometry {:.0f}x{:.0f} points, aspect {:.4f} ({}16:9)",
+                  now.width, now.height, aspect,
+                  std::abs(aspect - 16.0 / 9.0) < 0.005 ? "== " : "!= ");
+    }
+  }
+#endif
   if (self.owner) {
     self.owner->HandleResize();
