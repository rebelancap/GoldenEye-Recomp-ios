+#if TARGET_OS_VISION
+// The guest renders 16:9 and the presenter letterboxes anything else, so a
+// window the user has dragged into a different shape gets black bars. Ask the
+// system for 16:9 and for UNIFORM resizing, which keeps the aspect ratio while
+// the user drags the corner -- so the window can be any size and the game
+// always fills it (the user, headset, 0.1.0.70: "force it to stay a certain
+// aspect ratio so there's no letterboxing, and FILL the window"). D-025.
+//
+// 1280x720 points is the initial size; at the Vision Pro's 2x display scale
+// that is 2560x1440 pixels, which is also what resolution_scale 2 renders.
+void RexApplyVisionSceneGeometry(UIWindowScene* scene) {
+  if (!scene) return;
+  // Belt: the scene-level restrictions, which the system consults when it
+  // proposes a size of its own.
+  UISceneSizeRestrictions* restrictions = scene.sizeRestrictions;
+  if (restrictions) {
+    restrictions.minimumSize = CGSizeMake(640, 360);
+    restrictions.maximumSize = CGSizeMake(3840, 2160);
+  }
+  // Braces: the actual geometry request, which is the only thing that sets the
+  // resizing restriction.
+  if (@available(visionOS 1.0, *)) {
+    UIWindowSceneGeometryPreferencesVision* prefs =
+        [[UIWindowSceneGeometryPreferencesVision alloc] initWithSize:CGSizeMake(1280, 720)];
+    prefs.minimumSize = CGSizeMake(640, 360);
+    prefs.maximumSize = CGSizeMake(3840, 2160);
+    prefs.resizingRestrictions = UIWindowSceneResizingRestrictionsUniform;
+    [scene requestGeometryUpdateWithPreferences:prefs
+                                   errorHandler:^(NSError* error) {
+                                     REXLOG_ERROR("visionOS: geometry request refused: {}",
+                                                  error.localizedDescription.UTF8String
+                                                      ? error.localizedDescription.UTF8String
+                                                      : "(no description)");
+                                   }];
+    REXLOG_INFO("visionOS: requested 1280x720 with uniform (aspect-locked) resizing");
+  }
 }
 #endif
 
