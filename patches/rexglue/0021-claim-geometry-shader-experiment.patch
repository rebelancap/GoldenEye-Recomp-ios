+
+    // EXPERIMENT (GoldenEye-Recomp-ios, M-030): Metal has no geometry shaders,
+    // so MoltenVK reports geometryShader = false and the runtime falls back to
+    // its primitive conversion/expansion paths -- which upstream has apparently
+    // never exercised for this title (Windows and Linux both report true).
+    //
+    // CrossOver's Vulkan layer ADVERTISES geometryShader on macOS even though
+    // MoltenVK cannot compile one; the upstream Windows build therefore takes
+    // the geometry-shader path, individual draws fail at pipeline creation, and
+    // it still runs a full frame loop (M-029). Replicate that: claim the feature
+    // in the properties the emulation reads, while leaving it OUT of
+    // enabled_features so vkCreateDevice still succeeds.
+    if (REXCVAR_GET(vulkan_claim_geometry_shader) && !supported_features.geometryShader) {
+      device->properties_.geometryShader = VK_TRUE;
+      REXLOG_INFO("* geometryShader (CLAIMED -- not actually supported; see M-030)");
+    }
