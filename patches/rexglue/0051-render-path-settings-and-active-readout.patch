 }  // namespace rex::graphics::vulkan
+
+namespace {
+std::atomic<int> g_active_render_target_path{-1};
+}  // namespace
+
+static void RexPublishActiveRenderTargetPath(int path) {
+  g_active_render_target_path.store(path, std::memory_order_relaxed);
+}
+
+// The path this launch actually runs, as distinct from what the init-only cvar
+// asked for (Setup may fall back to fbo when interlock is unsupported).
+// Reached by dlsym from the settings page and the console bridge.
+extern "C" const char* RexActiveRenderTargetPath() {
+  switch (g_active_render_target_path.load(std::memory_order_relaxed)) {
+    case 0:
+      return "fbo";
+    case 1:
+      return "fsi";
+    default:
+      return "not-initialized";
+  }
+}
