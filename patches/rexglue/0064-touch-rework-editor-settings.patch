+
+- (void)resetLayout {
+  NSUserDefaults* d = NSUserDefaults.standardUserDefaults;
+  for (const auto& spec : kButtons) {
+    [d removeObjectForKey:GePosKey(spec.label, "x")];
+    [d removeObjectForKey:GePosKey(spec.label, "y")];
+  }
+  [_savedUnit removeAllObjects];
+  rex::cvar::SetFlagByName("touch_button_scale", "1.0");
+  rex::ui::PersistSettings();
