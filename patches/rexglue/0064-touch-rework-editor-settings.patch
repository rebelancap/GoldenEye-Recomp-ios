+// --- layout editor -------------------------------------------------------
+// The chrome and behavior mirror the family's editors (quake ports / vkQuake
+// lineage): reset pill, live scale slider with a percentage, done pill,
+// bottom-left; dragging is self-evident, so no instruction text.
+
+- (void)commitDrag {
+  if (!_dragLabel) return;
+  NSValue* v = _savedUnit[_dragLabel];
+  if (v) {
+    const CGPoint u = v.CGPointValue;
+    NSUserDefaults* d = NSUserDefaults.standardUserDefaults;
+    [d setDouble:u.x forKey:GePosKey(_dragLabel.UTF8String, "x")];
+    [d setDouble:u.y forKey:GePosKey(_dragLabel.UTF8String, "y")];
+    REXLOG_INFO("touch layout: {} -> ({:.3f}, {:.3f})", _dragLabel.UTF8String, u.x, u.y);
+  }
+  _dragLabel = nil;
+}
