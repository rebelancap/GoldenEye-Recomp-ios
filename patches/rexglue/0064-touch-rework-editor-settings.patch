+    if (x && y) {
+      [text appendFormat:@"%s %.4f %.4f\n", spec.label, x.doubleValue, y.doubleValue];
+    } else {
+      [text appendFormat:@"%s (table default)\n", spec.label];
+    }
+  }
+  // Side effects: the bridge's log window and the Files app both get a copy.
+  for (NSString* line in [text componentsSeparatedByString:@"\n"]) {
+    if (line.length) REXLOG_INFO("layout export: {}", line.UTF8String);
+  }
+  auto path = rex::filesystem::GetDocumentsFolder() / "touch-layout.txt";
+  NSError* err = nil;
+  if (![text writeToFile:@(path.string().c_str())
+              atomically:YES
+                encoding:NSUTF8StringEncoding
+                   error:&err]) {
+    REXLOG_ERROR("layout export: write failed: {}", err.description.UTF8String ?: "?");
+  }
