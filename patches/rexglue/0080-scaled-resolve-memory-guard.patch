+  // Memory guard for scaled rendering (D-025 / M-105). MoltenVK has no sparse
+  // buffer residency, so the scaled-resolve buffer is COMMITTED in full --
+  // 512 MB * scale^2, i.e. 2 GB at 2x and 4.5 GB at 3x. Measured on the macOS
+  // bench, the process footprint went 2.0 GB (1x) -> 4.0 GB (2x) -> 7.0 GB
+  // (3x). A phone or headset that cannot afford that must not die at GPU init
+  // over a setting: InitializeScaledResolveBuffer would fail and take the
+  // whole boot with it, leaving a player who chose 1440p with an app that no
+  // longer launches and no way back to the settings page. Clamp here instead.
+  //
+  // The budget comes from VK_EXT_memory_budget, which on Apple platforms
+  // MoltenVK derives from the process's own available memory -- the number
+  // jetsam actually enforces -- rather than from the heap size, which on a
+  // unified-memory device is just the machine's RAM.
   if (draw_resolution_scale_x > 1 || draw_resolution_scale_y > 1) {
+    VkDeviceSize device_local_budget = 0;
+    if (vulkan_device->extensions().ext_EXT_memory_budget &&
+        vulkan_device->vulkan_instance()->extensions().ext_1_1_KHR_get_physical_device_properties2) {
+      VkPhysicalDeviceMemoryBudgetPropertiesEXT budget_properties = {};
+      budget_properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT;
+      VkPhysicalDeviceMemoryProperties2 memory_properties2 = {};
+      memory_properties2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2;
+      memory_properties2.pNext = &budget_properties;
+      vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceMemoryProperties2(
+          vulkan_device->physical_device(), &memory_properties2);
+      const VkPhysicalDeviceMemoryProperties& mp = memory_properties2.memoryProperties;
+      for (uint32_t i = 0; i < mp.memoryTypeCount; ++i) {
+        if (!(mp.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+          continue;
+        }
+        device_local_budget =
+            std::max(device_local_budget, budget_properties.heapBudget[mp.memoryTypes[i].heapIndex]);
+      }
+    }
+    if (device_local_budget) {
+      // Half the budget is the ceiling for this one buffer: the guest's own
+      // 512 MB shared-memory buffer, every render target, every host texture
+      // and the swapchain all come out of the same budget.
+      const uint64_t allowance = uint64_t(device_local_budget) / 2;
+      uint32_t clamped_x = draw_resolution_scale_x;
+      uint32_t clamped_y = draw_resolution_scale_y;
+      while ((clamped_x > 1 || clamped_y > 1) &&
+             uint64_t(SharedMemory::kBufferSize) * uint64_t(clamped_x) * uint64_t(clamped_y) >
+                 allowance) {
+        if (clamped_x >= clamped_y) {
+          --clamped_x;
+        } else {
+          --clamped_y;
+        }
+      }
+      if (clamped_x != draw_resolution_scale_x || clamped_y != draw_resolution_scale_y) {
+        REXGPU_WARN(
+            "Draw resolution scale {}x{} needs a {} MB scaled-resolve buffer but only {} MB of "
+            "the {} MB device-local budget may go to it -- rendering at {}x{} instead",
+            draw_resolution_scale_x, draw_resolution_scale_y,
+            (uint64_t(SharedMemory::kBufferSize) * draw_resolution_scale_x *
+             draw_resolution_scale_y) >> 20,
+            allowance >> 20, uint64_t(device_local_budget) >> 20, clamped_x, clamped_y);
+        draw_resolution_scale_x = clamped_x;
+        draw_resolution_scale_y = clamped_y;
+      } else {
+        REXGPU_INFO(
+            "Draw resolution scale {}x{}: {} MB scaled-resolve buffer against a {} MB "
+            "device-local budget",
+            draw_resolution_scale_x, draw_resolution_scale_y,
+            (uint64_t(SharedMemory::kBufferSize) * draw_resolution_scale_x *
+             draw_resolution_scale_y) >> 20,
+            uint64_t(device_local_budget) >> 20);
+      }
+    } else {
+      REXGPU_WARN(
+          "Draw resolution scale {}x{} requested with no memory budget available to check it "
+          "against -- the scaled-resolve buffer will be {} MB",
+          draw_resolution_scale_x, draw_resolution_scale_y,
+          (uint64_t(SharedMemory::kBufferSize) * draw_resolution_scale_x *
+           draw_resolution_scale_y) >> 20);
+    }
+  }
+  if (draw_resolution_scale_x > 1 || draw_resolution_scale_y > 1) {
     REXGPU_WARN(
         "Vulkan draw resolution scaling is experimental and may not affect all "
