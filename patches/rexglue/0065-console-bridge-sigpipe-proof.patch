 namespace {
 
+// A client that hangs up mid-reply (`log 2000 | head`, a dropped network link)
+// must never take the game with it. Without this, the next ::send into the
+// closed socket raised SIGPIPE and iOS killed the process with signal 13 --
+// 0.1.0.59 died exactly that way on the user's phone (2026-09-04) while the
+// console was tailing its own log. Two layers: the accepted socket is marked
+// SO_NOSIGPIPE, and the whole process ignores SIGPIPE (nothing in this runtime
+// relies on it -- EPIPE from send() is the only signal we want).
+void SendAll(int fd, const char* data, size_t size) {
+  while (size > 0) {
+    const ssize_t n = ::send(fd, data, size, 0);
+    if (n <= 0) {
+      return;  // EPIPE / reset: the client is gone; the caller closes the fd.
+    }
+    data += size_t(n);
+    size -= size_t(n);
+  }
+}
