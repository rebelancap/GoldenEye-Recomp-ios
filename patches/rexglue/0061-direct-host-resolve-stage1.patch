+        builder.createBinOp(
+            spv::OpShiftLeftLogical, type_uint4,
+            builder.createBinOp(spv::OpBitwiseAnd, type_uint4, v, m_00ff00ff), c8),
+        builder.createBinOp(
+            spv::OpShiftRightLogical, type_uint4,
+            builder.createBinOp(spv::OpBitwiseAnd, type_uint4, v, m_ff00ff00), c8));
+    spv::Id v1 = builder.createTriOp(spv::OpSelect, type_uint4, endian_8in16, swapped16, v);
+    spv::Id rotated = builder.createBinOp(
+        spv::OpBitwiseOr, type_uint4,
+        builder.createBinOp(spv::OpShiftLeftLogical, type_uint4, v1, c16),
+        builder.createBinOp(spv::OpShiftRightLogical, type_uint4, v1, c16));
+    return builder.createTriOp(spv::OpSelect, type_uint4, endian_16rot, rotated, v1);
+  };
+  data_lo = endian_apply(data_lo);
+  if (!full_shape) data_hi = endian_apply(data_hi);
+
+  spv::Id const_int_0 = builder.makeIntConstant(0);
+  id_vector_temp.clear();
+  id_vector_temp.push_back(const_int_0);
+  id_vector_temp.push_back(builder.createUnaryOp(spv::OpBitcast, type_int, dest_index));
+  builder.createStore(data_lo, builder.createAccessChain(spv::StorageClassUniform, dest_buffer,
+                                                         id_vector_temp));
+  if (!full_shape) {
+    spv::Id dest_index_hi =
+        builder.createBinOp(spv::OpIAdd, type_uint, dest_index, const_uint_2);
+    id_vector_temp.clear();
+    id_vector_temp.push_back(const_int_0);
+    id_vector_temp.push_back(builder.createUnaryOp(spv::OpBitcast, type_int, dest_index_hi));
+    builder.createStore(data_hi, builder.createAccessChain(spv::StorageClassUniform, dest_buffer,
+                                                           id_vector_temp));
+  }
+
+  guard_if.makeEndIf();
+
+  builder.leaveFunction();
+  builder.addExecutionMode(main_function, spv::ExecutionModeLocalSize, 8, 8, 1);
+  spv::Instruction* entry_point =
+      builder.addEntryPoint(spv::ExecutionModelGLCompute, main_function, "main");
+  entry_point->addIdOperand(input_global_invocation_id);
+
+  std::vector<unsigned int> shader_code;
+  builder.dump(shader_code);
+
+  VkPipeline pipeline = ui::vulkan::util::CreateComputePipeline(
+      command_processor_.GetVulkanDevice(),
+      dump_key.is_depth ? direct_resolve_pipeline_layout_depth_
+                        : direct_resolve_pipeline_layout_color_,
+      reinterpret_cast<const uint32_t*>(shader_code.data()), sizeof(uint32_t) * shader_code.size());
+  if (pipeline == VK_NULL_HANDLE) {
+    REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the direct resolve pipeline");
+  }
   direct_resolve_pipelines_.emplace(key, pipeline);
   return pipeline;
 }
 
