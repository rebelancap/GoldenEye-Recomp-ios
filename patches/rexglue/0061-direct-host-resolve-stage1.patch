+  spv::Id endian_8in16 = builder.createBinOp(
+      spv::OpLogicalOr, type_bool,
+      builder.createBinOp(spv::OpIEqual, type_bool, dest_endian, const_uint_1),
+      builder.createBinOp(spv::OpIEqual, type_bool, dest_endian, const_uint_2));
+  spv::Id endian_16rot = builder.createBinOp(
+      spv::OpLogicalOr, type_bool,
