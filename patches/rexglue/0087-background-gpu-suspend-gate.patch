+  const bool drained = AwaitAllQueueOperationsCompletion();
+  REXGPU_INFO("HOSTSUSPEND: Vulkan CP quiesced (drained={}, submission {} completed {})", drained,
+              GetCurrentSubmission(), submission_completed_);
