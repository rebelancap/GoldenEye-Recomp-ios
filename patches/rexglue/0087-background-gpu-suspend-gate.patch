+// --- Host GPU suspend gate (M-111) -------------------------------------------
+//
+// iOS and visionOS revoke GPU access from a process that is not foreground.
+// Metal fails the command buffer, MoltenVK reports VK_ERROR_DEVICE_LOST, and
+// the runtime's only reaction to a lost device is rex::FatalError -- so every
+// Digital Crown press on the Vision Pro aborted the app, with the same stack in
+// three separate crash reports (IssueDraw -> BeginSubmission ->
+// CheckSubmissionFenceAndDeviceLoss -> OnHostGpuLossFromAnyThread -> abort).
+//
+// The fix is to stop touching the GPU before the OS takes it away, and to start
+// again when it is handed back. rex/host_suspend.h holds the gate; this is the
+// half that knows about app lifecycle.
+//
+// Both the application notifications and the scene notifications are observed.
+// On iOS the application ones fire; on visionOS the app is scene-based and the
+// scene ones are the reliable signal (the application-level ones still fire for
+// the last scene, but relying on that is how a port ends up crashing only in
+// multi-window). Request() is idempotent, so hearing both costs nothing.
+void RexSuspendHostGpu(NSNotification* note) {
+  REXLOG_INFO("iOS: lifecycle {} -- suspending the host GPU",
+              note.name ? note.name.UTF8String : "?");
+  rex::host_suspend::Request();
+  // Bounded: the GPU worker has to close its open submission and wait its
+  // fences out, and we must not sit in a lifecycle callback long enough for the
+  // OS watchdog to notice. 500 ms is ~30 frames of headroom for a drain that
+  // normally costs one. A timeout is not fatal -- it only means the classifier
+  // in the Vulkan backend, rather than the drain, is what keeps the next fence
+  // error from being read as a lost device.
+  if (!rex::host_suspend::WaitForAck(500)) {
+    REXLOG_WARN(
+        "iOS: host GPU did not reach the suspend gate within 500 ms -- proceeding; the "
+        "device-loss classifier covers the window");
+  }
+}
+
+void RexResumeHostGpu(NSNotification* note) {
+  REXLOG_INFO("iOS: lifecycle {} -- resuming the host GPU",
+              note.name ? note.name.UTF8String : "?");
+  rex::host_suspend::Release();
+}
+
+void RexObserveLifecycleForHostGpu() {
+  NSNotificationCenter* nc = NSNotificationCenter.defaultCenter;
+  NSArray<NSNotificationName>* suspend_names = @[
+    UIApplicationWillResignActiveNotification,
+    UIApplicationDidEnterBackgroundNotification,
+    UISceneWillDeactivateNotification,
+    UISceneDidEnterBackgroundNotification,
+  ];
+  for (NSNotificationName name in suspend_names) {
+    [nc addObserverForName:name
+                    object:nil
+                     queue:NSOperationQueue.mainQueue
+                usingBlock:^(NSNotification* note) { RexSuspendHostGpu(note); }];
+  }
+  NSArray<NSNotificationName>* resume_names = @[
+    UIApplicationDidBecomeActiveNotification,
+    UISceneDidActivateNotification,
+  ];
+  for (NSNotificationName name in resume_names) {
+    [nc addObserverForName:name
+                    object:nil
+                     queue:NSOperationQueue.mainQueue
+                usingBlock:^(NSNotification* note) { RexResumeHostGpu(note); }];
+  }
+  REXLOG_INFO("iOS: host GPU suspend gate armed on {} suspend / {} resume notifications",
+              suspend_names.count, resume_names.count);
+}
