+std::filesystem::path GetDocumentsFolder() {
+#if REX_PLATFORM_IOS
+  // The sandbox rewrites HOME to the app container, so this is the container's
+  // own Documents/ -- the directory UIFileSharingEnabled publishes to the Files
+  // app. Created eagerly: the user has to be able to see it and drop the game
+  // data in before the app has ever written anything.
+  if (const char* home = std::getenv("HOME")) {
+    auto documents = std::filesystem::path(home) / "Documents";
+    std::error_code ec;
+    std::filesystem::create_directories(documents, ec);
+    return documents;
+  }
+#endif
+  return {};
+}
+
+std::filesystem::path GetCachesFolder() {
+#if REX_PLATFORM_IOS
+  if (const char* home = std::getenv("HOME")) {
+    auto caches = std::filesystem::path(home) / "Library" / "Caches";
+    std::error_code ec;
+    std::filesystem::create_directories(caches, ec);
+    return caches;
+  }
+#endif
+  return GetUserFolder() / "cache";
+}
+
 FILE* OpenFile(const std::filesystem::path& path, const std::string_view mode) {
