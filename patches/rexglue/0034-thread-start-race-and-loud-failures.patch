--- a/src/core/threading_posix.cpp
+++ b/src/core/threading_posix.cpp
@@ -1368,16 +1368,31 @@
   current_thread_ = thread;
   current_thread_condition_ = &thread->handle_;
   {
+    // One critical section, deliberately. Publishing the state is what releases
+    // Resume()'s WaitStarted(), so suspend_count_ must already be set by the
+    // time that happens -- otherwise Resume() can run in the gap, observe a
+    // count of 0, return false without doing anything, and leave this thread to
+    // set the count to 1 and wait for a wakeup that will never come.
+    //
+    // Nothing checks Resume()'s return value, so the result is a thread that
+    // was "created successfully" and simply never runs. It is timing-dependent:
+    // rare on a desktop, common on a phone, where the new thread is likely to
+    // start on an efficiency core and take much longer to get here. That is how
+    // this presented -- a different GPU or audio worker missing on each launch
+    // (M-046).
     std::unique_lock<std::mutex> lock(thread->handle_.state_mutex_);
     thread->handle_.state_ = create_suspended ? State::kSuspended : State::kRunning;
-    thread->handle_.state_signal_.notify_all();
-  }
+    if (create_suspended) {
+      thread->handle_.suspend_count_ = 1;
+    }
+    thread->handle_.state_signal_.notify_all();
 
-  if (create_suspended) {
-    std::unique_lock<std::mutex> lock(thread->handle_.state_mutex_);
-    thread->handle_.suspend_count_ = 1;
-    thread->handle_.state_signal_.wait(lock,
-                                       [thread] { return thread->handle_.suspend_count_ == 0; });
+    if (create_suspended) {
+      // Re-checks the predicate on entry, so a Resume() that lands between the
+      // notify above and this wait is honoured rather than lost.
+      thread->handle_.state_signal_.wait(lock,
+                                         [thread] { return thread->handle_.suspend_count_ == 0; });
+    }
   }
 
   start_routine();
