--- a/src/system/xsocket.cpp
+++ b/src/system/xsocket.cpp
@@ -29,6 +29,18 @@
 #include <netinet/in.h>
 #include <netinet/ip.h>
 #include <sys/socket.h>
+#endif
+
+#if defined(__APPLE__)
+// Darwin defines IPPROTO_* as object-like macros expanding to integer literals,
+// so `XSocket::Protocol::IPPROTO_UDP` becomes `Protocol::17`. (glibc also
+// #defines them, but to themselves, which is harmless.) Drop the macros -- this
+// translation unit only ever names the enumerators, never the system values.
+#undef IPPROTO_IP
+#undef IPPROTO_ICMP
+#undef IPPROTO_TCP
+#undef IPPROTO_UDP
+#undef IPPROTO_RAW
 #endif
 
 namespace rex::system {
