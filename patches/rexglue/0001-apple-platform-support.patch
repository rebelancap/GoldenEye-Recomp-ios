--- a/src/kernel/CMakeLists.txt
+++ b/src/kernel/CMakeLists.txt
@@ -67,4 +67,16 @@
 list(TRANSFORM REXKERNEL_SOURCES PREPEND "${CMAKE_CURRENT_SOURCE_DIR}/")
 target_sources(rexruntime PRIVATE ${REXKERNEL_SOURCES})
 
-target_link_libraries(rexruntime PRIVATE o1heap rexcore rexfilesystem rexgraphics rexui rexaudio rexinput imgui)
+if(REXGLUE_TOOLS_ONLY)
+    # Host backends are not built in tools-only mode (see the top-level
+    # CMakeLists), but the XAM layer genuinely calls into audio/input/ui -- so
+    # rexruntime.dylib has ~23 unresolved externals it can never satisfy here.
+    # Defer them to load time. The only consumer in this mode is the `rexglue`
+    # codegen CLI, which never boots a guest and so never reaches them; a
+    # tools-only rexruntime is NOT a runnable game runtime and must never be
+    # shipped as one.
+    target_sources(rexruntime PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/tools_only_stubs.cpp)
+    target_link_libraries(rexruntime PRIVATE o1heap rexcore rexfilesystem imgui)
+else()
+    target_link_libraries(rexruntime PRIVATE o1heap rexcore rexfilesystem rexgraphics rexui rexaudio rexinput imgui)
+endif()
