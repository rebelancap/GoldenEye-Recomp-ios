-# Enforce Clang18 compiler
-if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
-    message(FATAL_ERROR "ReXGlue requires Clang compiler. Please set CMAKE_CXX_COMPILER to clang++")
-endif()
+# Enforce Clang18 compiler.
+# AppleClang is accepted on Apple platforms: the iOS/visionOS toolchain is not
+# optional there (SDK headers, Objective-C++, codesigning all require Xcode's
+# clang), and Homebrew LLVM cannot target them. AppleClang version numbers do
+# not track LLVM's -- Xcode 16.3 (AppleClang 17) is the C++23 floor we need.
+if(APPLE)
+    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(Apple)?Clang$")
+        message(FATAL_ERROR "ReXGlue requires Clang. Found ${CMAKE_CXX_COMPILER_ID}.")
+    endif()
+    if(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS "17.0")
+        message(FATAL_ERROR "ReXGlue requires AppleClang 17 (Xcode 16.3) or newer (found ${CMAKE_CXX_COMPILER_VERSION})")
+    endif()
+    if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS "18.0")
+        message(FATAL_ERROR "ReXGlue requires Clang 18 or newer (found ${CMAKE_CXX_COMPILER_VERSION})")
+    endif()
+else()
+    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+        message(FATAL_ERROR "ReXGlue requires Clang compiler. Please set CMAKE_CXX_COMPILER to clang++")
+    endif()
 
-if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "18.0")
-    message(FATAL_ERROR "ReXGlue requires Clang 18 or newer (found ${CMAKE_CXX_COMPILER_VERSION})")
+    if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "18.0")
+        message(FATAL_ERROR "ReXGlue requires Clang 18 or newer (found ${CMAKE_CXX_COMPILER_VERSION})")
+    endif()
 endif()
 
 # Enforce x64 architecture
@@ -133,8 +150,31 @@
         set(REX_PLATFORM "linux-${CMAKE_SYSTEM_PROCESSOR}")
     endif()
     add_compile_definitions(REX_PLATFORM_LINUX=1)
+elseif(APPLE)
+    # Apple: macOS (host/oracle) plus the iOS + visionOS targets this port ships.
+    # CMAKE_SYSTEM_NAME is Darwin / iOS / visionOS; CMAKE_SYSTEM_PROCESSOR is
+    # arm64 (or x86_64 on an Intel host / the older simulators).
+    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+        set(REX_PLATFORM_OS "ios")
+    elseif(CMAKE_SYSTEM_NAME STREQUAL "visionOS")
+        set(REX_PLATFORM_OS "visionos")
+    else()
+        set(REX_PLATFORM_OS "macos")
+    endif()
+    if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|ARM64")
+        set(REX_PLATFORM "${REX_PLATFORM_OS}-arm64")
+    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64")
+        set(REX_PLATFORM "${REX_PLATFORM_OS}-amd64")
+    else()
+        set(REX_PLATFORM "${REX_PLATFORM_OS}-${CMAKE_SYSTEM_PROCESSOR}")
+    endif()
+    # rex/platform.h derives REX_PLATFORM_MAC from TargetConditionals.h. Note
+    # TARGET_OS_MAC is 1 on EVERY Apple platform (it is the umbrella macro), so
+    # iOS/visionOS also take the MAC path there -- intentional for now; anything
+    # that must distinguish them uses TARGET_OS_IPHONE / TARGET_OS_VISION.
+    add_compile_definitions(REX_PLATFORM_APPLE=1)
 else()
-    message(FATAL_ERROR "Unsupported platform. ReXGlue supports Windows and Linux only.")
+    message(FATAL_ERROR "Unsupported platform. ReXGlue supports Windows, Linux and Apple platforms.")
 endif()
 
