+# The `rexglue` codegen CLI needs only core/filesystem/system/kernel/codegen.
+# REXGLUE_TOOLS_ONLY drops the host backends (window, renderer, audio, input) so
+# the recompiler can be built and run on a platform whose backends do not exist
+# yet -- which is exactly how this port bootstraps on macOS/iOS.
+if(NOT REXGLUE_TOOLS_ONLY)
+    add_subdirectory(src/ui)
+    add_subdirectory(src/input)
+    add_subdirectory(src/audio)
+    add_subdirectory(src/graphics)
+endif()
 add_subdirectory(src/system)
 add_subdirectory(src/kernel)
 add_subdirectory(src/codegen)
