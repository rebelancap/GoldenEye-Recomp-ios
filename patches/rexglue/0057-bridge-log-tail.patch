+    if (!path) return "error: no log file (logging not initialized or console-only)\n";
+    if (auto* flush_fn = FlushLogs()) flush_fn();  // push queued async lines to disk first
+    std::ifstream f(path, std::ios::binary | std::ios::ate);
+    if (!f) return std::string("error: cannot open ") + path + "\n";
+    // Read a bounded chunk off the end rather than the whole file: logs grow
+    // to tens of MB in a long session and the bridge reply is a socket write.
+    const std::streamoff size = f.tellg();
+    const std::streamoff chunk = std::min<std::streamoff>(size, 256 * 1024);
+    f.seekg(size - chunk);
+    std::string buf(size_t(chunk), '\0');
+    f.read(buf.data(), chunk);
+    buf.resize(size_t(f.gcount()));
+    size_t pos = buf.size();
+    int lines = 0;
+    while (pos > 0 && lines <= want) {
+      size_t nl = buf.rfind('\n', pos - 1);
+      if (nl == std::string::npos) { pos = 0; break; }
+      ++lines;
+      pos = nl;
+    }
+    // pos sits on the newline BEFORE the oldest wanted line (or 0).
+    std::ostringstream out;
+    out << path << " (last " << std::min(lines, want) << " lines):\n";
+    out << buf.substr(pos ? pos + 1 : 0);
+    if (buf.empty() || buf.back() != '\n') out << "\n";
+    return out.str();
+  }
