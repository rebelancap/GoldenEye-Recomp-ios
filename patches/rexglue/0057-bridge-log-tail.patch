+// Remote log access (console bridge `log [n]`). C linkage so the bridge can
+// dlsym them, matching how it reaches every other optional facility. The path
+// is stable after InitLogging; the flush pushes queued async lines to disk so
+// a tail taken immediately after reads current, not seconds-stale, output.
+extern "C" const char* RexGetCurrentLogPath() {
+  std::lock_guard lock(g_mutex);
+  return g_log_file_path.empty() ? nullptr : g_log_file_path.c_str();
+}
+
+extern "C" void RexFlushLogs() {
+  std::lock_guard lock(g_mutex);
+  for (auto& entry : g_registry)
+    if (entry.logger)
+      entry.logger->flush();
+}
