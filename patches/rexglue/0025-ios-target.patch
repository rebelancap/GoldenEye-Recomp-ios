--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -5,10 +5,18 @@
 #=============================================================================
 # Architecture detection
 #=============================================================================
-if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
+# CMAKE_SYSTEM_PROCESSOR is empty when cross-compiling to iOS/visionOS; fall
+# back to the requested architectures (see the same fallback in the top-level
+# CMakeLists). Getting this wrong silently drops FFmpeg's NEON sources and only
+# shows up as unresolved ff_*_aarch64 at link time.
+set(REX_TP_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
+if(NOT REX_TP_ARCH AND CMAKE_OSX_ARCHITECTURES)
+    list(GET CMAKE_OSX_ARCHITECTURES 0 REX_TP_ARCH)
+endif()
+if(REX_TP_ARCH MATCHES "^(x86_64|AMD64)$")
     set(IS_ARM64 FALSE)
     set(IS_X86_64 TRUE)
-elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
+elseif(REX_TP_ARCH MATCHES "^(aarch64|arm64|ARM64)$")
     set(IS_ARM64 TRUE)
     set(IS_X86_64 FALSE)
 else()
