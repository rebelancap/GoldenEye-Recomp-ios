 // XInput button bits, named here so the layout table below reads as controls
 // rather than as magic numbers.
 constexpr uint16_t kBtnA = 0x1000;
+// --- screen fill ---------------------------------------------------------
+//
+// The game's frame is 16:9. A modern phone is not (an iPhone Air is ~19.5:9,
+// an iPhone 17 Pro Max ~2.17:1), so something has to give. `screen_fill` is the
+// player's choice of WHICH axis fills the screen, and this is the only place
+// that turns it into runtime state:
+//
+//   width   fill the screen's width. The presenter trims the top and bottom of
+//           the frame, and -- because a bare width crop on a 2.17:1 screen
+//           still leaves the game's own black surround visible -- the game's
+//           SCREEN LETTERBOX is put into WIDE, which draws the picture into a
+//           ~2.38:1 band inside the 16:9 frame and moves the HUD in with it.
+//           The presenter then scales that BAND to the screen's height (see
+//           the zoom below), so what gets trimmed is the surround, not the
+//           picture, and no bars are left.
+//   height  fill the screen's height: the whole 16:9 frame, bars at the sides,
+//           game letterbox FULL. Nothing is trimmed.
+//
+// There was a "wide" mode (video_mode_width = 720 * screen aspect, so the game
+// itself would render the wider frame). On the phone it came up as a squeezed,
+// near-square image in the middle of the screen: the title does not honour a
+// non-16:9 video mode (seen on device, 1.0.0.2, 2026-09-10; D-030). Removed. The
+// video-mode cvars are still pinned to 1280x720 at startup so a ge.toml left
+// over from that build boots normally.
+//
+// present_* are set unconditionally for the chosen mode rather than only when
+// non-default: leaving a previous mode's values behind is how a "height" launch
+// would come up cropped.
+
+// The aspect of the band the game draws into with SCREEN LETTERBOX = WIDE, as a
+// constant because the presenter has to know it without being able to see it.
+// Measured off a 1.0.0.2 screenshot: the screen was 921 points tall and, at a
+// 2.1714:1 display aspect, was showing 720 * (16/9) / 2.1714 ~= 590 guest lines
+// of the frame; the picture occupied rows ~40..880, i.e. (840 / 921) * 590
+// ~= 538 guest lines of the 1280-wide frame -> 1280 / 538 ~= 2.38.
+constexpr double kGameWideBandAspect = 2.38;
+
+void ApplyScreenFill(uint32_t surface_w, uint32_t surface_h, bool at_startup) {
+  // Orientation-proof: this runs from -loadView, where UIScreen.bounds can
+  // still be reported portrait even though the app is landscape-only.
+  const uint32_t long_side = std::max<uint32_t>(1, std::max(surface_w, surface_h));
+  const uint32_t short_side = std::max<uint32_t>(1, std::min(surface_w, surface_h));
+  const double display_aspect = double(long_side) / double(short_side);
+  const double guest_aspect = 16.0 / 9.0;
+
+  const std::string mode = REXCVAR_GET(screen_fill);
+  const bool fill_width = (mode != "height");
+
+  bool overscan = false;
+  int32_t safe_x = 90, safe_y = 90;  // the cvars' own defaults
+  int32_t zoom = 100;                // present_zoom_percent, 100 = fit/crop rect
+  bool want_wide = false;            // ask the guest for SCREEN LETTERBOX = WIDE
+  const int32_t video_w = 1280, video_h = 720;
+
+  // Within 1% of 16:9 (a Vision Pro window) there is nothing to fill: both
+  // modes are the same picture, so neither trims a pixel.
+  const bool worth_it = std::abs(display_aspect - guest_aspect) > guest_aspect * 0.01;
+
+  if (display_aspect > guest_aspect) {
+    // The screen is WIDER than the frame. Filling the height is what the
+    // presenter does by default (bars at the sides); filling the width means
+    // cropping Y.
+    if (fill_width && worth_it) {
+      overscan = true;
+      want_wide = true;
+      // How much of the frame's height the presenter is allowed to crop away.
+      // Floor, so the margin can never round the other way and reintroduce a
+      // hairline bar. NOTE this only ever lets the presenter crop DOWN to the
+      // fill-width rectangle -- see the zoom below for the rest.
+      safe_y = int32_t(std::floor(100.0 * guest_aspect / display_aspect));
+      safe_y = std::clamp(safe_y, 1, 99);
+      // No extra zoom to the WIDE band (1.0.0.3 tried zoom = band / display,
+      // ~110% here). The band only exists in GAMEPLAY: the front-end menus
+      // and the watch are drawn across the whole frame, and the zoom took ~19%
+      // off the top and bottom of them (reported on device, 2026-09-10: "crops it quite a
+      // bit"). The thin bars the band leaves in gameplay are the price of
+      // menus that stay whole; kGameWideBandAspect is kept for a possible
+      // gameplay-only zoom keyed on GeInGameplay (D-031).
+      (void)kGameWideBandAspect;
+    }
+  } else {
+    // The screen is TALLER than the frame (a 4:3 iPad). Filling the width is
+    // the presenter's default here; filling the height means cropping X.
+    if (!fill_width && worth_it) {
+      overscan = true;
+      safe_x = int32_t(std::floor(100.0 * display_aspect / guest_aspect));
+      safe_x = std::clamp(safe_x, 1, 99);
+    }
+  }
+
+  auto set = [](const char* name, const std::string& value) {
+    // video_mode_* are kRequiresRestart. SetFlagByName only refuses kInitOnly
+    // cvars after FinalizeInit -- a restart-lifecycle cvar set here, before the
+    // guest has booted, is applied for real. The console bridge's separate
+    // refusal of restart cvars is a bridge-side policy and does not reach here.
+    if (!rex::cvar::SetFlagByName(name, value)) {
+      REXLOG_ERROR("screen fill: could not set {} = {}", name, value);
+    }
+  };
+  set("present_allow_overscan_cutoff", overscan ? "true" : "false");
+  set("present_safe_area_x", std::to_string(safe_x));
+  set("present_safe_area_y", std::to_string(safe_y));
+  set("present_zoom_percent", std::to_string(zoom));
+  if (at_startup) {
+    // Never at runtime: the guest read the mode at boot and is drawing into
+    // render targets sized from it.
+    set("video_mode_width", std::to_string(video_w));
+    set("video_mode_height", std::to_string(video_h));
+  }
+
+  // Write the game's OWN screen settings for the player -- the chosen picture is
+  // our crop PLUS the in-game SCREEN LETTERBOX / SCREEN RATIO pair, and nobody
+  // should have to find that menu. Resolved through dlsym exactly as
+  // GeInjectLookDelta and GeInGameplay are (the game module is linked in, but
+  // this file must not depend on it). The guest side stores the request and
+  // performs it on the next guest frame that has the settings struct.
+  {
+    using SetScreenFn = void (*)(int, int);
+    static SetScreenFn set_screen = nullptr;
+    if (!set_screen) {
+      set_screen = reinterpret_cast<SetScreenFn>(dlsym(RTLD_DEFAULT, "GeSetScreenSettings"));
+    }
+    if (set_screen) {
+      // letterbox: FULL = 0, WIDE = 1. ratio: 16:9 = 2, always -- the frame is
+      // 16:9 whatever we do with it at the edges.
+      // LETTERBOX FULL=0 / WIDE=1; RATIO 16:9=1 (bench 2026-09-10 -- the game's
+      // ratio encoding is NORMAL=0, 16:9=1, 21:9=2, not the menu's order).
+      set_screen(want_wide ? 1 : 0, 1);
+    } else {
+      REXLOG_ERROR(
+          "screen fill: GeSetScreenSettings not found -- the game's own screen settings are "
+          "left as the player last saved them");
+    }
+  }
+
+  REXLOG_INFO(
+      "screen fill: mode={} surface={}x{} aspect={:.4f} -> overscan={} safe_x={} safe_y={} "
+      "zoom={} game_letterbox={} video_mode={}x{}{}",
+      mode, surface_w, surface_h, display_aspect, overscan ? "true" : "false", safe_x, safe_y,
+      zoom, want_wide ? "wide" : "full",
+      at_startup ? video_w : rex::cvar::Query<int32_t>("video_mode_width"),
+      at_startup ? video_h : rex::cvar::Query<int32_t>("video_mode_height"),
+      at_startup ? "" : " (runtime: video mode untouched)");
+}
+
+// Cheap poll shared by the display-link tick: re-applies only when the mode or
+// the surface actually changed.
+void PollScreenFill(UIView* view) {
+  static std::string last_mode;
+  static uint32_t last_w = 0, last_h = 0;
+  const CGFloat scale = view.contentScaleFactor > 0 ? view.contentScaleFactor : (CGFloat)2.0;
+  const CGSize size = view.bounds.size;
+  const uint32_t w = uint32_t(std::lround(size.width * scale));
+  const uint32_t h = uint32_t(std::lround(size.height * scale));
+  const std::string mode = REXCVAR_GET(screen_fill);
+  if (mode == last_mode && w == last_w && h == last_h) {
+    return;
+  }
+  last_mode = mode;
+  last_w = w;
+  last_h = h;
+  if (w == 0 || h == 0) {
+    return;
+  }
+  ApplyScreenFill(w, h, false);
+}
