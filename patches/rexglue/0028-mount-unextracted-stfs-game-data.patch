+std::filesystem::path StfsContainerDevice::FindPackageIn(const std::filesystem::path& root) {
+  std::error_code ec;
+  if (std::filesystem::is_regular_file(root, ec)) {
+    return ReadPackageHeader(root) ? root : std::filesystem::path{};
+  }
+
+  // Deep enough for the scene layout (0000000000000000/<title>/<type>/<hash>),
+  // shallow enough that an extracted asset tree costs nothing to reject.
+  constexpr int kMaxDepth = 4;
+  constexpr int kMaxCandidates = 64;
+  int examined = 0;
+
+  std::filesystem::recursive_directory_iterator it(
+      root, std::filesystem::directory_options::skip_permission_denied, ec);
+  if (ec) {
+    return {};
+  }
+  for (const auto& entry : it) {
+    if (it.depth() >= kMaxDepth) {
+      it.disable_recursion_pending();
+    }
+    if (!entry.is_regular_file(ec)) {
+      continue;
+    }
+    // A package for a full XBLA title is hundreds of MB; the size floor keeps
+    // us from reading a header off every .nfo and .diz sitting beside it.
+    if (entry.file_size(ec) < 1024 * 1024) {
+      continue;
+    }
+    if (ReadPackageHeader(entry.path())) {
+      return entry.path();
+    }
+    if (++examined >= kMaxCandidates) {
+      break;
+    }
+  }
+  return {};
+}
