     .range(1, 8)
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
-REXCVAR_DEFINE_INT32(draw_resolution_scale_y, 1, "GPU", "Draw resolution scale Y (1 = no scaling)")
+REXCVAR_DEFINE_INT32(draw_resolution_scale_y, REX_DEFAULT_DRAW_RESOLUTION_SCALE, "GPU", "Draw resolution scale Y (1 = no scaling)")
     .range(1, 8)
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
-REXCVAR_DEFINE_INT32(resolution_scale, 1, "GPU",
+REXCVAR_DEFINE_INT32(resolution_scale, REX_DEFAULT_DRAW_RESOLUTION_SCALE, "GPU",
