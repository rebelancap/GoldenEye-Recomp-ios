+// WAIT_REG_MEM accounting. This packet is where the emulated GPU waits on a
+// value someone else must write, and it is the whole of the frame's stall
+// (M-051): one blocking wait per frame, released by the guest's vblank ISR, so
+// every frame costs a whole number of 16.67 ms periods (M-052).
+std::atomic<uint64_t> g_wrm_waits{0};
+std::atomic<uint64_t> g_wrm_us{0};
+std::atomic<uint64_t> g_wrm_max_us{0};
+// The address of the longest-blocking wait, and what it wanted -- identifying
+// the writer was the whole question.
+std::atomic<uint32_t> g_wrm_worst_addr{0};
+std::atomic<uint32_t> g_wrm_worst_ref{0};
+std::atomic<uint32_t> g_wrm_worst_op{0};
+std::atomic<uint32_t> g_wrm_worst_is_mem{0};
+// Offset from the preceding vblank at which each wait cleared. Clustered near
+// zero means the vblank ISR is the writer; uniformly spread means it is not.
+std::atomic<uint64_t> g_wrm_since_vblank_sum{0};
+std::atomic<uint64_t> g_wrm_since_vblank_n{0};
+std::atomic<uint64_t> g_wrm_since_vblank_max{0};
+}  // namespace
+
 namespace rex::graphics {
 
+void GetWaitRegMemVblankPhase(uint64_t* mean_us, uint64_t* max_us, uint64_t* n) {
+  const uint64_t count = g_wrm_since_vblank_n.exchange(0, std::memory_order_relaxed);
+  const uint64_t sum = g_wrm_since_vblank_sum.exchange(0, std::memory_order_relaxed);
+  if (n) *n = count;
+  if (mean_us) *mean_us = count ? sum / count : 0;
+  if (max_us) *max_us = g_wrm_since_vblank_max.exchange(0, std::memory_order_relaxed);
+}
+
+void GetWaitRegMemWorst(uint32_t* addr, uint32_t* ref, uint32_t* op, uint32_t* is_memory) {
+  if (addr) *addr = g_wrm_worst_addr.load(std::memory_order_relaxed);
+  if (ref) *ref = g_wrm_worst_ref.load(std::memory_order_relaxed);
+  if (op) *op = g_wrm_worst_op.load(std::memory_order_relaxed);
+  if (is_memory) *is_memory = g_wrm_worst_is_mem.load(std::memory_order_relaxed);
+}
+
+void GetWaitRegMemStats(uint64_t* waits, uint64_t* total_us, uint64_t* max_us) {
+  // exchange: the console reports the interval since it last looked.
+  if (waits) *waits = g_wrm_waits.exchange(0, std::memory_order_relaxed);
+  if (total_us) *total_us = g_wrm_us.exchange(0, std::memory_order_relaxed);
+  if (max_us) *max_us = g_wrm_max_us.exchange(0, std::memory_order_relaxed);
+}
+
+}  // namespace rex::graphics
+
+// Unmangled aliases; see rex/ui/vulkan/presenter_timings.h for why the console
+// bridge reaches these by name rather than by linking rexgraphics.
+extern "C" void RexGetWaitRegMemStats(uint64_t* waits, uint64_t* total_us, uint64_t* max_us) {
+  rex::graphics::GetWaitRegMemStats(waits, total_us, max_us);
+}
+extern "C" void RexGetWaitRegMemWorst(uint32_t* addr, uint32_t* ref, uint32_t* op,
+                                      uint32_t* is_memory) {
+  rex::graphics::GetWaitRegMemWorst(addr, ref, op, is_memory);
+}
+extern "C" void RexGetWaitRegMemVblankPhase(uint64_t* mean_us, uint64_t* max_us, uint64_t* n) {
+  rex::graphics::GetWaitRegMemVblankPhase(mean_us, max_us, n);
+}
