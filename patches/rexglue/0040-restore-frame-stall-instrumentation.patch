+// Presenter timing. The round-5 question was whether the per-frame stall was
+// our own work or the display pipeline handing back a drawable on its own
+// schedule; acquire and present are exactly where that distinction shows up.
+// The answer turned out to be neither (M-054: one drawable wait in 41.7 s), and
+// these stay because a presenter that starts blocking again must be visible
+// immediately rather than re-argued from scratch.
+//
+// Relaxed atomics: written once per frame on the paint thread, read from the
+// console thread, and a torn read costs a stale microsecond.
+std::atomic<uint64_t> g_acquire_us{0};
+std::atomic<uint64_t> g_present_us{0};
+std::atomic<uint64_t> g_acquire_max_us{0};
+std::atomic<uint64_t> g_present_max_us{0};
+
+inline uint64_t NowMicros() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+}  // namespace
+
+void GetPresenterTimings(uint64_t* acquire_us, uint64_t* present_us, uint64_t* acquire_max_us,
+                         uint64_t* present_max_us) {
+  if (acquire_us) *acquire_us = g_acquire_us.load(std::memory_order_relaxed);
+  if (present_us) *present_us = g_present_us.load(std::memory_order_relaxed);
+  if (acquire_max_us) *acquire_max_us = g_acquire_max_us.exchange(0, std::memory_order_relaxed);
+  if (present_max_us) *present_max_us = g_present_max_us.exchange(0, std::memory_order_relaxed);
+}
 
+}  // namespace vulkan
+}  // namespace ui
+}  // namespace rex
+
+extern "C" void RexGetPresenterTimings(uint64_t* acquire_us, uint64_t* present_us,
+                                       uint64_t* acquire_max_us, uint64_t* present_max_us) {
+  rex::ui::vulkan::GetPresenterTimings(acquire_us, present_us, acquire_max_us, present_max_us);
+}
