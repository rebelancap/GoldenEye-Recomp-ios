+void VulkanCommandProcessor::DumpEdramBeforeResolve() {
+  // Same sequence as InitializeTrace: record the EDRAM download into the open
+  // submission, submit-and-await, then read the mapping back on the CPU.
+  if (!render_target_cache_->InitializeTraceSubmitDownloads()) {
+    REXGPU_ERROR("edramdump: InitializeTraceSubmitDownloads failed");
+    return;
+  }
+  AwaitAllQueueOperationsCompletion();
+
+  bool fsi = render_target_cache_->GetPath() == RenderTargetCache::Path::kPixelShaderInterlock;
+  uint32_t serial = g_edram_dump_serial.fetch_add(1, std::memory_order_relaxed);
+  std::string base = std::string(g_edram_dump_dir) + "/edram-" + (fsi ? "fsi" : "fbo") + "-" +
+                     std::to_string(serial);
+  std::string bin_path = base + ".bin";
+  if (!render_target_cache_->WriteEdramSnapshotToFile(bin_path.c_str())) {
+    return;
+  }
+
+  // Register sidecar: everything the analysis needs to locate and interpret
+  // the render targets inside the raw EDRAM bytes.
+  const RegisterFile& regs = *register_file_;
+  auto rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto rb_depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  auto rb_copy_control = regs.Get<reg::RB_COPY_CONTROL>();
+  auto rb_copy_dest_info = regs.Get<reg::RB_COPY_DEST_INFO>();
+  auto rb_copy_dest_pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  if (FILE* file = std::fopen((base + ".txt").c_str(), "w")) {
+    std::fprintf(file, "path=%s\n", fsi ? "fsi" : "fbo");
+    std::fprintf(file, "surface_pitch=%u\n", uint32_t(rb_surface_info.surface_pitch));
+    std::fprintf(file, "msaa_samples=%u\n", uint32_t(rb_surface_info.msaa_samples));
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+      std::fprintf(file, "rt%u_base_tiles=%u rt%u_format=%u rt%u_blendcontrol=%08X\n", i,
+                   uint32_t(color_info.color_base), i, uint32_t(color_info.color_format), i,
+                   uint32_t(regs[reg::RB_BLENDCONTROL::rt_register_indices[i]]));
+    }
+    std::fprintf(file, "depth_base_tiles=%u depth_format=%u\n", uint32_t(rb_depth_info.depth_base),
+                 uint32_t(rb_depth_info.depth_format));
+    std::fprintf(file, "colorcontrol=%08X\n", uint32_t(regs[XE_GPU_REG_RB_COLORCONTROL]));
+    std::fprintf(file, "color_mask=%08X\n", uint32_t(regs[XE_GPU_REG_RB_COLOR_MASK]));
+    std::fprintf(file,
+                 "copy: src_select=%u sample_select=%u color_clear=%u depth_clear=%u "
+                 "dest_format=%u dest_pitch=%u dest_height=%u\n",
+                 uint32_t(rb_copy_control.copy_src_select),
+                 uint32_t(rb_copy_control.copy_sample_select),
+                 uint32_t(rb_copy_control.color_clear_enable),
+                 uint32_t(rb_copy_control.depth_clear_enable),
+                 uint32_t(rb_copy_dest_info.copy_dest_format),
+                 uint32_t(rb_copy_dest_pitch.copy_dest_pitch),
+                 uint32_t(rb_copy_dest_pitch.copy_dest_height));
+    std::fclose(file);
+  }
+  REXGPU_INFO("edramdump: wrote {}", bin_path);
+}
