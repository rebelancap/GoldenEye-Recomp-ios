   auto* is = input_system();
-  return is->GetState(actual_user_index, input_state);
+  const X_RESULT result = is->GetState(actual_user_index, input_state);
+
+  // Scripted input (GoldenEye-Recomp-ios overlay). Drives the guest with a
+  // timed button script so a headless run can be walked into gameplay without a
+  // controller -- the seed of the sim-validate harness the charter asks for, and
+  // the only way to reach in-mission rendering on this machine today.
+  //
+  // Format: "<ms>:<BUTTON>[,<ms>:<BUTTON>...]", e.g. "8000:A,12000:A,20000:START".
+  // Each entry holds the button for ~120 ms from its timestamp.
+  if (result == X_ERROR_SUCCESS && input_state && actual_user_index == 0) {
+    const uint16_t scripted = rex::kernel::xam::ScriptedButtonsNow();
+    if (scripted) {
+      input_state->gamepad.buttons = uint16_t(input_state->gamepad.buttons) | scripted;
+    }
+  }
+  return result;
+}
+
+// --- Scripted input support (GoldenEye-Recomp-ios overlay) --------------------
+uint16_t ScriptedButtonsNow() {
+  static const std::vector<std::pair<uint64_t, uint16_t>> script = [] {
+    std::vector<std::pair<uint64_t, uint16_t>> out;
+    const std::string spec = REXCVAR_GET(input_script);
+    static const struct { const char* name; uint16_t bit; } kButtons[] = {
+        {"DPAD_UP", 0x0001},  {"DPAD_DOWN", 0x0002}, {"DPAD_LEFT", 0x0004},
+        {"DPAD_RIGHT", 0x0008}, {"START", 0x0010},   {"BACK", 0x0020},
+        {"A", 0x1000},        {"B", 0x2000},         {"X", 0x4000},
+        {"Y", 0x8000},
+    };
+    size_t pos = 0;
+    while (pos < spec.size()) {
+      const size_t comma = spec.find(',', pos);
+      const std::string entry = spec.substr(pos, comma == std::string::npos ? comma : comma - pos);
+      const size_t colon = entry.find(':');
+      if (colon != std::string::npos) {
+        const uint64_t at_ms = std::strtoull(entry.substr(0, colon).c_str(), nullptr, 10);
+        const std::string name = entry.substr(colon + 1);
+        for (const auto& b : kButtons) {
+          if (name == b.name) {
+            out.emplace_back(at_ms, b.bit);
+            break;
+          }
+        }
+      }
+      if (comma == std::string::npos) break;
+      pos = comma + 1;
+    }
+    if (!out.empty()) {
+      REXKRNL_INFO("Scripted input: {} event(s) from '{}'", out.size(), spec);
+    }
+    return out;
+  }();
+  if (script.empty()) {
+    return 0;
+  }
+  static const auto start = std::chrono::steady_clock::now();
+  const uint64_t now_ms = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                       std::chrono::steady_clock::now() - start)
+                                       .count());
+  uint16_t buttons = 0;
+  for (const auto& [at_ms, bit] : script) {
+    if (now_ms >= at_ms && now_ms < at_ms + 120) {
+      buttons |= bit;
+    }
+  }
+  return buttons;
 }
 
