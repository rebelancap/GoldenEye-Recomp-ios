+// rx-0086: append `value` to a small distinct-value set, counting overflow.
+template <typename T>
+void CensusAddDistinct(T* values, uint32_t& count, uint32_t& extra, uint32_t capacity, T value) {
+  for (uint32_t i = 0; i < count; ++i) {
+    if (values[i] == value) {
+      return;
+    }
+  }
+  if (count < capacity) {
+    values[count++] = value;
+  } else {
+    ++extra;
+  }
+}
