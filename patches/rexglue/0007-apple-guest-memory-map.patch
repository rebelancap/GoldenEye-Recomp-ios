+#if defined(__APPLE__)
+// Apple Silicon (macOS, iOS and visionOS alike) uses a 16 KB host page. The
+// guest's memory model is the Xbox 360's, whose smallest heaps are 4 KB-paged,
+// so mprotect/mmap get 4 KB-aligned addresses and lengths and reject them with
+// EINVAL. Round the request out to the enclosing host pages.
+//
+// CONSEQUENCE, and it is not free: host protection becomes 16 KB-granular. Four
+// adjacent 4 KB guest pages share one host page, so protecting one of them
+// protects all four. Guest-visible protection state stays exact -- BaseHeap's
+// page_table_ is the authority for anything the guest queries -- but anything
+// that depends on the HOST enforcing 4 KB precision is now coarser:
+//   * GPU write-watch (graphics/shared_memory.cpp) will see false invalidations
+//     from writes to neighbouring guest pages. A perf cost, not a correctness
+//     one -- it re-uploads data that did not change.
+//   * A 4 KB guard page cannot be isolated; its 16 KB host page may stay
+//     accessible because a neighbour is committed.
+// See docs/memory-math.md. Revisit if either shows up in a Phase 3 measurement.
+static inline void ClampToHostPages(void*& base_address, size_t& length) {
+  if (!base_address) {
+    return;
+  }
+  const uintptr_t page = uintptr_t(page_size());
+  const uintptr_t addr = reinterpret_cast<uintptr_t>(base_address);
+  const uintptr_t begin = addr & ~(page - 1);
+  const uintptr_t end = (addr + length + page - 1) & ~(page - 1);
+  base_address = reinterpret_cast<void*>(begin);
+  length = size_t(end - begin);
+}
+#endif
