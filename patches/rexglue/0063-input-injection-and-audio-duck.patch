+        fields[i] = unsigned(strtoul(part.c_str(), nullptr, i == 0 ? 16 : 10));
+        if (colon == std::string::npos) break;
+        pos = colon + 1;
+      }
+      if (fields[0] || fields[2] || fields[3]) {
+        GeInjectPadPulse(uint16_t(fields[0]), uint8_t(std::min(fields[2], 255u)),
+                         uint8_t(std::min(fields[3], 255u)), fields[1] ? fields[1] : 200u);
+      }
+      rex::cvar::SetFlagByName("ge_test_buttons", "");
