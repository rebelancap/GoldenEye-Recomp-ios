 // --- Scripted input support (GoldenEye-Recomp-ios overlay) --------------------
+
+// Injected button pulse. Two front-ends share it: the ge_test_buttons bridge
+// cvar (bench experiments on live processes) and GeInjectButtonPulse via dlsym
+// (the iOS settings page's graphics-toggle row). Written from whichever thread
+// asks, read on the guest's input poll -- hence the atomics; the two stores
+// don't need to be one unit, a torn pair just shortens or lengthens a pulse by
+// a poll.
+namespace {
+std::atomic<uint16_t> g_pulse_mask{0};
+std::atomic<uint8_t> g_pulse_rt{0};  // triggers too: FIRE is the right trigger,
+std::atomic<uint8_t> g_pulse_lt{0};  // and the M-081 un-wedge cure is a FIRE mash
+std::atomic<int64_t> g_pulse_deadline_ms{0};
+
+int64_t SteadyNowMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+}  // namespace
+
+extern "C" void GeInjectPadPulse(uint16_t mask, uint8_t rt, uint8_t lt, uint32_t hold_ms) {
+  g_pulse_mask.store(mask, std::memory_order_relaxed);
+  g_pulse_rt.store(rt, std::memory_order_relaxed);
+  g_pulse_lt.store(lt, std::memory_order_relaxed);
+  g_pulse_deadline_ms.store(SteadyNowMs() + int64_t(hold_ms), std::memory_order_relaxed);
+  REXKRNL_INFO("GEBTN pulse {:#06x} rt={} lt={} for {} ms", mask, rt, lt, hold_ms);
+}
+
+extern "C" void GeInjectButtonPulse(uint16_t mask, uint32_t hold_ms) {
+  GeInjectPadPulse(mask, 0, 0, hold_ms);
+}
+
+// Trigger half of the pulse, sampled by the merge site alongside the buttons.
+void ScriptedTriggersNow(uint8_t* rt, uint8_t* lt) {
+  if (SteadyNowMs() < g_pulse_deadline_ms.load(std::memory_order_relaxed)) {
+    *rt = std::max(*rt, g_pulse_rt.load(std::memory_order_relaxed));
+    *lt = std::max(*lt, g_pulse_lt.load(std::memory_order_relaxed));
+  }
+}
+
