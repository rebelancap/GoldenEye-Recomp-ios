--- a/src/ge_hooks.cpp
+++ b/src/ge_hooks.cpp
@@ -1013,6 +1013,22 @@
 // the stall is silent. Arming it at startup costs one sleeping thread and makes
 // the diagnostics available from the first frame onward.
 void StartGpuWatchdog() { ge_start_watchdog_once(); }
+
+// Read the guest's own frame counters -- the same words the GESTATUS line
+// reports. These live in the guest's device struct, so they describe what the
+// *game* believes about its frame pacing rather than what the host renderer is
+// doing, which is the number that matters when asking why it feels slow.
+void GetGpuSubmitPresentCounts(uint64_t* out_submitted, uint64_t* out_presented) {
+  if (out_submitted) *out_submitted = 0;
+  if (out_presented) *out_presented = 0;
+  auto* memory = rex::Runtime::instance() ? rex::Runtime::instance()->memory() : nullptr;
+  if (!memory) return;
+  uint8_t* base = memory->virtual_membase();
+  uint32_t dev = g_ge_device.load(std::memory_order_relaxed);
+  if (!base || !dev) return;
+  if (out_submitted) *out_submitted = LD32(base, dev + 16544);
+  if (out_presented) *out_presented = LD32(base, dev + 16552);
+}
 
