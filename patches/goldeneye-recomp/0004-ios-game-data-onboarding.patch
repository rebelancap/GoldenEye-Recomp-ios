+#if REX_PLATFORM_IOS
+  // The app ships with no game data -- the user drops their own file set into
+  // Documents/assets through the Files app. On desktop a missing drop is an
+  // error on stderr; on iOS there is nothing to read it, so hold initialization
+  // here and put the instructions on screen instead.
+  //
+  // This is the SDK's async path-resolution seam working as designed: return
+  // nullopt to say "not yet", and call resume once the user has supplied a
+  // usable set. Boot continues from there with no special-casing downstream.
+  std::optional<rex::PathConfig> OnFinalizePaths(const rex::PathConfig& defaults,
+                                                 std::function<void(rex::PathConfig)> resume)
+      override {
+    auto game_dir = defaults.game_data_root.empty()
+                        ? rex::filesystem::GetDocumentsFolder() / "assets"
+                        : defaults.game_data_root;
+
+    auto status = rex::ui::ClassifyGameData(game_dir);
+    if (status.usable()) {
+      REXLOG_INFO("game data: {}", status.detail);
+      auto paths = defaults;
+      paths.game_data_root = game_dir;
+      return paths;
+    }
+
+    REXLOG_WARN("game data not usable yet: {}", status.detail);
+    rex::ui::PresentGameDataOnboarding(game_dir, [this, defaults, game_dir, resume]() {
+      auto paths = defaults;
+      paths.game_data_root = game_dir;
+      resume(paths);
+    });
+    return std::nullopt;
+  }
+#endif  // REX_PLATFORM_IOS
