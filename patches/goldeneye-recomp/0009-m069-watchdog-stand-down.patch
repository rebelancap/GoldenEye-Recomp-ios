+// M-069: fault-proof guest access for the watchdog thread ONLY. The runtime
+// protects guest pages at will (MMIO ranges, texture-cache write-watches), and
+// a raw host-thread read of a protected page cannot be resolved by the MMIO
+// exception machinery the way a guest-code access can -- it re-faults forever.
+// Profiled live: 19.2M faults, ~18M consecutive on one address, the watchdog
+// 79% of a core inside _sigtramp, and every legitimate guest write-watch fault
+// serialized behind the same MMIO-handler lock -> presents frozen. That is the
+// device hard freeze ("68.8% busy in libsystem_platform" == _sigtramp).
+// vm_read_overwrite copies in the kernel and returns an error on protected or
+// unmapped pages: no signal, no handler, no loop -- by construction.
+#if defined(__APPLE__)
+bool ge_wd_read(uint8_t* b, uint32_t ga, void* dst, size_t len) {
+  vm_size_t out = 0;
+  return vm_read_overwrite(mach_task_self(), reinterpret_cast<vm_address_t>(b + ga), len,
+                           reinterpret_cast<vm_address_t>(dst), &out) == KERN_SUCCESS &&
+         out == len;
+}
+uint32_t WD32(uint8_t* b, uint32_t ga) {
+  uint32_t v = 0;
+  if (!ge_wd_read(b, ga, &v, 4)) return 0;
+  return __builtin_bswap32(v);
+}
+uint8_t WD8(uint8_t* b, uint32_t ga) {
+  uint8_t v = 0;
+  ge_wd_read(b, ga, &v, 1);
+  return v;
+}
+bool WDST32(uint8_t* b, uint32_t ga, uint32_t val) {
+  uint32_t v = __builtin_bswap32(val);
+  if (vm_write(mach_task_self(), reinterpret_cast<vm_address_t>(b + ga),
+               reinterpret_cast<vm_offset_t>(&v), 4) == KERN_SUCCESS) {
+    return true;
+  }
+  // vm_write refuses write-watched pages (KERN_PROTECTION_FAILURE) -- but a
+  // direct store to a READABLE page faults at most once and the MMIO handler
+  // resolves it, exactly like every legitimate host-side write to watched
+  // memory. Only unreadable (PROT_NONE / MMIO) pages risk the fault loop, so
+  // probe with a read first. Without this fallback the CP-semaphore
+  // auto-recovery silently stopped working (M-070: freezes went from 1-in-15
+  // boots to 2-in-4 when the recovery poke started failing).
+  uint32_t probe;
+  if (!ge_wd_read(b, ga, &probe, 4)) {
+    return false;
+  }
+  std::memcpy(b + ga, &v, 4);
+  return true;
+}
+#else
+bool ge_wd_read(uint8_t* b, uint32_t ga, void* dst, size_t len) {
+  std::memcpy(dst, b + ga, len);
+  return true;
+}
+uint32_t WD32(uint8_t* b, uint32_t ga) { return LD32(b, ga); }
+uint8_t WD8(uint8_t* b, uint32_t ga) { return b[ga]; }
+bool WDST32(uint8_t* b, uint32_t ga, uint32_t val) {
+  ST32(b, ga, val);
+  return true;
+}
+#endif
 
+// Copy up to `want` bytes of guest memory, stopping at the first unreadable
+// page. Returns bytes copied.
+size_t ge_wd_read_run(uint8_t* b, uint32_t ga, void* dst, size_t want) {
+  const size_t page = size_t(getpagesize());
+  size_t got = 0;
+  while (got < want) {
+    size_t to_page = page - (reinterpret_cast<uintptr_t>(b + ga + got) & (page - 1));
+    size_t chunk = (want - got < to_page) ? want - got : to_page;
+    if (!ge_wd_read(b, ga + uint32_t(got), static_cast<uint8_t*>(dst) + got, chunk)) {
+      break;
+    }
+    got += chunk;
+  }
+  return got;
+}
