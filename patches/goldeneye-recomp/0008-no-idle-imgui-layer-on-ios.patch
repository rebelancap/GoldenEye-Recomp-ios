+    // Creating the overlay REGISTERS the ImGui drawer with the presenter, which
+    // then paints a UI layer every frame -- even though PostFxOverlay::OnDraw
+    // returns immediately while postfx_enabled is false, which is its default
+    // and the only state a phone can be in (the ImGui menus need a mouse). On a
+    // tile-based GPU an extra full-screen layer per frame is not free, so on
+    // iOS the dialog only exists if the filter is actually wanted.
+    //
+    // Consequence, deliberately accepted: turning postfx on from ge.toml takes
+    // effect at the next launch on iOS. It is a niche filter with no on-device
+    // UI, and paying for it every frame to avoid a relaunch is the wrong trade.
+#if REX_PLATFORM_IOS
+    if (REXCVAR_GET(postfx_enabled)) {
