+// Look-delta entry point for platform layers with no raw-mouse source (iOS
+// touch drag, future gyro). Resolved via dlsym from the runtime's UI layer, so
+// it must stay extern "C" and default-visibility. Units are mouse counts: the
+// mousehook applies (counts / 10) * ge_mouse_sens degrees to the camera, so a
+// rate-independent swipe turns the view by a screen-proportional angle instead
+// of saturating a virtual stick at the game's fixed turn rate.
+extern "C" __attribute__((visibility("default"))) void GeInjectLookDelta(int dx, int dy) {
+  if (!ge_mouse_active()) return;
+  g_mouse_dx.fetch_add(dx, std::memory_order_relaxed);
+  g_mouse_dy.fetch_add(dy, std::memory_order_relaxed);
+}
 
