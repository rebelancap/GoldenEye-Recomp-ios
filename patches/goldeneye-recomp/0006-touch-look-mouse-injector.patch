+std::atomic<uint32_t> g_wait_cycles{0};      // completed wait cycles this present
+std::atomic<uint64_t> g_wait_ticks{0};       // ticks spent inside waits
+std::atomic<uint64_t> g_between_ticks{0};    // ticks spent outside waits
+// Per thread, not global. Several guest threads poll this hook, and a shared
+// "when did the last wait end" marker interleaves them: thread A's wait start
+// gets differenced against thread B's wait end, and `between` becomes a
+// meaningless mixture. The cycle *count* is still a process-wide sum, which is
+// what we want -- it is the per-thread timing that must not be crossed.
+thread_local uint32_t t_last_wait_end = 0;
