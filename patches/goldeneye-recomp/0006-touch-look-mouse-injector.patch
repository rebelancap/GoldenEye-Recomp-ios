+void GetFramePhases(uint32_t* out_cycles, uint64_t* out_wait_us, uint64_t* out_between_us) {
+  // 49.875 MHz guest timebase -> microseconds.
+  constexpr double kTicksPerUs = 49.875;
+  if (out_cycles) *out_cycles = g_frame_wait_cycles.load(std::memory_order_relaxed);
+  if (out_wait_us)
+    *out_wait_us = uint64_t(double(g_frame_wait_ticks.load(std::memory_order_relaxed)) / kTicksPerUs);
+  if (out_between_us)
+    *out_between_us =
+        uint64_t(double(g_frame_between_ticks.load(std::memory_order_relaxed)) / kTicksPerUs);
+}
