+#else
+// POSIX/Apple: resolve our own image path and posix_spawn a detached copy.
+// _NSGetExecutablePath may return a non-canonical path (symlinks, "./"), so it
+// is passed through realpath before exec.
+void LaunchSelfDetached() {
+  std::string exe_path;
+#if defined(__APPLE__)
+  uint32_t size = 0;
+  _NSGetExecutablePath(nullptr, &size);      // query the required length
+  std::vector<char> buf(size + 1, '\0');
+  if (_NSGetExecutablePath(buf.data(), &size) != 0) {
+    REXKRNL_INFO("GE LaunchSelfDetached: could not resolve the executable path");
+    return;
+  }
+  char resolved[PATH_MAX];
+  exe_path = realpath(buf.data(), resolved) ? resolved : buf.data();
+#else
+  char resolved[PATH_MAX];
+  ssize_t n = readlink("/proc/self/exe", resolved, sizeof(resolved) - 1);
+  if (n <= 0) {
+    REXKRNL_INFO("GE LaunchSelfDetached: could not resolve the executable path");
+    return;
+  }
+  resolved[n] = '\0';
+  exe_path = resolved;
+#endif
+  char* argv[] = {const_cast<char*>(exe_path.c_str()), nullptr};
+  pid_t pid = 0;
+  const int rc = posix_spawn(&pid, exe_path.c_str(), nullptr, nullptr, argv, environ);
+  if (rc != 0) {
+    REXKRNL_INFO("GE LaunchSelfDetached: posix_spawn failed ({})", rc);
+  }
+}
+#endif
 }  // namespace ge
 
