+namespace {
+// The watchdog walks guest stacks defensively: it needs to know how far it can
+// read from a host pointer before hitting an unmapped page. Windows answers with
+// VirtualQuery; POSIX answers with mincore, which returns ENOMEM precisely when
+// a page in the range is unmapped. Returns the end of the readable run (capped
+// at p + want), or nullptr if p itself is not readable.
+#if !defined(_WIN32)
+bool ge_page_mapped(const void* addr) {
+  const size_t page = size_t(getpagesize());
+  void* aligned =
+      reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(addr) & ~uintptr_t(page - 1));
+  char resident = 0;
+  return mincore(aligned, page, &resident) == 0;
+}
+#endif
+
+uint8_t* ge_readable_end(uint8_t* p, size_t want) {
+#if defined(_WIN32)
+  MEMORY_BASIC_INFORMATION mbi;
+  if (VirtualQuery(p, &mbi, sizeof(mbi)) != sizeof(mbi) || mbi.State != MEM_COMMIT ||
+      (mbi.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ |
+                      PAGE_EXECUTE_READWRITE)) == 0) {
+    return nullptr;
+  }
+  uint8_t* region_end = static_cast<uint8_t*>(mbi.BaseAddress) + mbi.RegionSize;
+  uint8_t* want_end = p + want;
+  return want_end < region_end ? want_end : region_end;
+#else
+  const size_t page = size_t(getpagesize());
+  if (!ge_page_mapped(p)) {
+    return nullptr;
+  }
+  uint8_t* want_end = p + want;
+  uint8_t* q = reinterpret_cast<uint8_t*>(
+      (reinterpret_cast<uintptr_t>(p) & ~uintptr_t(page - 1)) + page);
+  for (; q < want_end; q += page) {
+    if (!ge_page_mapped(q)) {
+      return q;  // first unmapped page bounds the run
+    }
+  }
+  return want_end;
+#endif
+}
+}  // namespace
